new file mode 100644
index 0000000000000000000000000000000000000000..3457a3f587aec7d6e58f89ed749599eaa01c3151
--- /dev/null
+++ b/entralinked/network/matchmaking/server.py
@@ -0,0 +1,96 @@
+"""Local listeners for DS friend-room discovery and negotiation."""
+import logging
+import os
+import socketserver
+import struct
+import threading
+from contextlib import ExitStack
+
+from .nat import nat_packet, retry_pairings
+from .rooms import discovery, forward_reservation, qr_packet
+
+logger = logging.getLogger(__name__)
+
+
+class _UDPHandler(socketserver.BaseRequestHandler):
+    def handle(self):
+        data, sock = self.request
+        try:
+            self.server.receive(self.server.context, sock, data, self.client_address)
+        except (ValueError, IndexError, struct.error, OSError):
+            logger.debug("Invalid or interrupted DS datagram")
+
+
+class _NATServer(socketserver.UDPServer):
+    def service_actions(self):
+        try:
+            retry_pairings(self.context.matcher)
+        except OSError:
+            logger.debug("Negotiation listener changed during a retry")
+
+
+class _BrowserHandler(socketserver.StreamRequestHandler):
+    def handle(self):
+        self.connection.settimeout(180)
+        try:
+            while header := self.rfile.read(2):
+                if len(header) != 2:
+                    return
+                size = int.from_bytes(header, "big")
+                if not 3 <= size <= 4096:
+                    return
+                data = header + self.rfile.read(size - 2)
+                if len(data) != size:
+                    return
+                if data[2] == 0:
+                    result = discovery(self.server.context, data, self.client_address)
+                    if result:
+                        self.wfile.write(result)
+                elif data[2] == 2:
+                    forward_reservation(self.server.context, data, self.client_address)
+        except (SyntaxError, ValueError, struct.error, OSError):
+            logger.debug("Invalid or interrupted DS room search")
+
+
+class _TCPServer(socketserver.ThreadingTCPServer):
+    allow_reuse_address = True
+    daemon_threads = True
+
+
+class MatchmakingServer:
+    def __init__(self, context, bind=None, ports=(27900, 27901, 28910)):
+        self.context = context
+        self.bind = bind or os.environ.get("DW_GAME_BIND", "127.0.0.1")
+        self.ports = ports
+        self.stack = ExitStack()
+        self.listeners = []
+
+    def start(self):
+        specs = ((socketserver.UDPServer, _UDPHandler, qr_packet),
+                 (_NATServer, _UDPHandler, nat_packet), (_TCPServer, _BrowserHandler, None))
+        with ExitStack() as opening:
+            for port, (cls, handler, callback) in zip(self.ports, specs, strict=True):
+                srv = opening.enter_context(cls((self.bind, port), handler))
+                srv.context = self.context
+                srv.receive = callback
+                thread = threading.Thread(target=srv.serve_forever, args=(0.25,), daemon=True)
+                thread.start()
+                opening.callback(thread.join)
+                opening.callback(srv.shutdown)
+                self.listeners.append(srv)
+            self.stack = opening.pop_all()
+        logger.info("Friend room discovery ready on %s", self.bind)
+
+    def stop(self):
+        closing = {srv.socket for srv in self.listeners}
+        self.stack.close()
+        directory = self.context.matcher
+        with directory.lock:
+            for endpoint, sock in list(directory.qr_sockets.items()):
+                if sock in closing:
+                    directory.rooms.pop(endpoint, None)
+            for cookie, pair in list(directory.pairings.items()):
+                if any(directory.nat_sockets.get(player.control_port) in closing for player in pair.peers.values()):
+                    directory.pairings.pop(cookie, None)
+            directory.expire()
+        self.listeners.clear()
