@@ -0,0 +1,64 @@
+"""Translate the three retail text encodings of a DWC buddy-match message."""
+import base64
+import re
+import struct
+
+from ..matchmaking.addresses import rewrite_match_data
+
+HEADERS = {"GPCM3vMAT": 3, "GPCM11vMAT": 11, "GPCM90vMAT": 90}
+DWC_TO_BASE64 = str.maketrans(".-*", "+/=")
+BASE64_TO_DWC = str.maketrans("+/=", ".-*")
+MAX_DATA = 512
+
+
+def _decode(version: int, payload: str) -> bytes:
+    if not payload:
+        return b""
+    if version == 90:
+        if len(payload) > 684 or not re.fullmatch(r"[A-Za-z0-9.\-]+\*{0,2}", payload):
+            raise ValueError("Invalid DWC base64.")
+        data = base64.b64decode(payload.translate(DWC_TO_BASE64), validate=True)
+    else:
+        words = payload.split("/")
+        if len(words) > MAX_DATA // 4:
+            raise ValueError("Too many DWC words.")
+        if version == 3:
+            if any(not re.fullmatch(r"[0-9]{1,10}", word) for word in words):
+                raise ValueError("Invalid DWC decimal word.")
+            values = [int(word) for word in words]
+            if any(word > 0xFFFFFFFF for word in values):
+                raise ValueError("DWC word is out of range.")
+            data = struct.pack(f"<{len(values)}I", *values)
+        else:
+            if any(not re.fullmatch("[a-fA-F0-9]{8}", word) for word in words):
+                raise ValueError("Invalid DWC hex word.")
+            data = bytes.fromhex("".join(words))
+    if len(data) > MAX_DATA or len(data) % 4:
+        raise ValueError("Invalid DWC payload length.")
+    return data
+
+
+def rewrite_buddy_match(source_ip: str, text: str) -> str:
+    """Pass ordinary GP messages through. Only re-encode when a DS endpoint changed."""
+    for header in HEADERS:
+        if text.startswith(header):
+            break
+    else:
+        return text
+    version = HEADERS[header]
+    if len(text) == len(header):
+        raise ValueError("Missing DWC command.")
+    raw_command = text[len(header)].encode("utf-8", errors="surrogateescape")
+    if len(raw_command) != 1:
+        raise ValueError("Invalid DWC command.")
+    data = _decode(version, text[len(header) + 1:])
+    result = rewrite_match_data(source_ip, version, raw_command[0], data)
+    if result == data:
+        return text
+    if version == 3:
+        payload = "/".join(str(word[0]) for word in struct.iter_unpack("<I", result))
+    elif version == 11:
+        payload = "/".join(result[offset:offset + 4].hex() for offset in range(0, len(result), 4))
+    else:
+        payload = base64.b64encode(result).decode("ascii").translate(BASE64_TO_DWC)
+    return text[:len(header) + 1] + payload
