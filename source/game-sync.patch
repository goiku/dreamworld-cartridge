@@ -0,0 +1,228 @@
+"""Authenticated GameSpy profiles, persistent two-way friendships and live invitations."""
+from __future__ import annotations
+
+import hmac
+import ipaddress
+import json
+import secrets
+import sqlite3
+import threading
+import time
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+from ...model.user.game_profile import GameProfile
+from ...utility.db_manager import DBManager, db
+from ..matchmaking.addresses import visible_endpoint
+from .match_message import rewrite_buddy_match
+
+if TYPE_CHECKING:
+    from socketserver import BaseServer
+
+    from .handler import GameSpyHandler
+
+
+def unique_nick(user_id: str, branch: str) -> str:
+    """The Nintendo WFC account name combines the 43-bit user ID and cartridge branch."""
+    number = int(user_id)
+    alphabet = "0123456789abcdefghijklmnopqrstuv"
+    return "".join(alphabet[(number >> shift) & 31] for shift in range(40, -1, -5)) + branch
+
+
+@dataclass
+class DirectoryEntry:
+    user_id: str
+    branch: str
+    profile: GameProfile
+
+    @property
+    def nick(self) -> str:
+        return unique_nick(self.user_id, self.branch)
+
+
+class GameSpyPresence:
+    def __init__(self, database: DBManager | None = None) -> None:
+        self.database = db if database is None else database
+        self._lock = threading.RLock()
+        self._online: dict[int, GameSpyHandler] = {}
+
+    def directory(self, profile_id: int | None = None) -> list[DirectoryEntry]:
+        sql = """SELECT user_id, p.key AS branch, p.value AS profile
+                 FROM wfc_users, json_each(wfc_users.profiles) AS p"""
+        params: tuple[int, ...] = ()
+        if profile_id is not None:
+            sql += " WHERE json_extract(p.value, '$.id') = ?"
+            params = (profile_id,)
+        return [DirectoryEntry(row["user_id"], row["branch"], GameProfile(**json.loads(row["profile"])))
+                for row in self.database.read_rows(sql, *params)]
+
+    def _relations(self, pid: int) -> list[sqlite3.Row]:
+        return self.database.read_rows(
+            "SELECT * FROM wfc_buddies WHERE first_pid=? OR second_pid=? ORDER BY requested_at, first_pid, second_pid",
+            pid, pid)
+
+    def are_buddies(self, a: int | None, b: int | None) -> bool:
+        if a is None or b is None or a == b:
+            return False
+        return bool(self.database.read_rows(
+            "SELECT 1 FROM wfc_buddies WHERE first_pid=? AND second_pid=? AND accepted=1", *sorted((a, b))))
+
+    def reverse_buddies(self, pid: int) -> list[int]:
+        return [self._other(row, pid) for row in self._relations(pid) if row["accepted"] or row["requester"] != pid]
+
+    @staticmethod
+    def _other(row: sqlite3.Row, pid: int) -> int:
+        return row["second_pid"] if row["first_pid"] == pid else row["first_pid"]
+
+    @staticmethod
+    def _send_buddy(client: GameSpyHandler | None, kind: int, origin: int, msg: str,
+                    timestamp: int | None = None) -> None:
+        if client is not None:
+            client.send_pairs([("bm", kind), ("f", origin), ("date", int(time.time()) if timestamp is None else timestamp),
+                               ("msg", msg)])
+
+    def _request(self, target: GameSpyHandler | None, row: sqlite3.Row) -> None:
+        text = row["reason"] + "\r\n\r\n|signed|" + row["signature"]
+        self._send_buddy(target, 2, row["requester"], text, row["requested_at"])
+
+    @staticmethod
+    def _status(client: GameSpyHandler | None) -> str:
+        if client is None or client.status_number == 0:
+            return "|s|0|ss|Offline"
+        endpoint = visible_endpoint(client.client_address, for_tcp=True)
+        address = int(ipaddress.IPv4Address(endpoint[0])) if endpoint else 0
+        return (f"|s|{client.status_number}|ss|{client.status_text}|ls|{client.location}"
+                f"|ip|{address}|p|0|qm|0")
+
+    def _exchange(self, pid: int, other: int, active: GameSpyHandler | None = None) -> None:
+        with self._lock:
+            left = self._online.get(pid)
+            right = self._online.get(other)
+        if active is not None and active is not left:
+            return
+        self._send_buddy(left, 100, other, self._status(right))
+        self._send_buddy(right, 100, pid, self._status(left))
+
+    def joined(self, client: GameSpyHandler) -> None:
+        pid = client.profile_id
+        with self._lock:
+            previous = self._online.get(pid)
+            self._online[pid] = client
+        if previous is not None and previous is not client:
+            previous.close_replaced()
+        for row in self._relations(pid):
+            if row["accepted"]:
+                self._exchange(pid, self._other(row, pid), client)
+            elif row["requester"] != pid:
+                self._request(client, row)
+
+    def current(self, client: GameSpyHandler) -> bool:
+        with self._lock:
+            return client.profile is not None and self._online.get(client.profile.id) is client
+
+    def search_authorized(self, pid: int, key: int, address: str) -> bool:
+        with self._lock:
+            client = self._online.get(pid)
+            return client is not None and client.session_key == key and client.client_address[0] == address
+
+    def close_listener(self, server: BaseServer) -> None:
+        with self._lock:
+            clients = [client for client in self._online.values() if client.server is server]
+        for client in clients:
+            self.left(client)
+            client.close_socket()
+
+    def left(self, client: GameSpyHandler) -> None:
+        with self._lock:
+            if not self.current(client):
+                return
+            pid = client.profile_id
+            del self._online[pid]
+            targets = [self._online.get(self._other(row, pid)) for row in self._relations(pid) if row["accepted"]]
+        for target in targets:
+            self._send_buddy(target, 100, pid, self._status(None))
+
+    def set_status(self, client: GameSpyHandler, number: int, text: str, location: str) -> None:
+        with self._lock:
+            if not self.current(client):
+                return
+            pid = client.profile_id
+            client.status_number, client.status_text, client.location = number, text, location
+            targets = [self._online.get(self._other(row, pid)) for row in self._relations(pid) if row["accepted"]]
+        status = self._status(client)
+        for target in targets:
+            self._send_buddy(target, 100, pid, status)
+
+    def add(self, client: GameSpyHandler, other: int, reason: str) -> None:
+        pid = client.profile_id
+        if other == pid or not self.directory(other):
+            client.send_error(0x601, "Unknown buddy profile.")
+            return
+        pair = sorted((pid, other))
+        with self.database.transaction() as conn:
+            row = conn.execute("SELECT * FROM wfc_buddies WHERE first_pid=? AND second_pid=?", pair).fetchone()
+            if row is None:
+                conn.execute("""INSERT INTO wfc_buddies(first_pid,second_pid,requester,signature,reason,requested_at)
+                                VALUES(?,?,?,?,?,?)""", (*pair, pid, secrets.token_hex(16), reason, int(time.time())))
+                row = conn.execute("SELECT * FROM wfc_buddies WHERE first_pid=? AND second_pid=?", pair).fetchone()
+            elif row["accepted"] or row["requester"] == pid:
+                return
+            else:
+                conn.execute("UPDATE wfc_buddies SET accepted=1 WHERE first_pid=? AND second_pid=?", pair)
+        with self._lock:
+            target = self._online.get(other)
+        if row["requester"] == pid:
+            self._request(target, row)
+        else:
+            self._authorized(client, other, target)
+
+    def accept(self, client: GameSpyHandler, other: int, signature: str) -> None:
+        pid = client.profile_id
+        pair = sorted((pid, other))
+        with self.database.transaction() as conn:
+            row = conn.execute("SELECT * FROM wfc_buddies WHERE first_pid=? AND second_pid=?", pair).fetchone()
+            if row is None or row["requester"] != other or not hmac.compare_digest(row["signature"], signature):
+                client.send_error(0x702, "Unknown buddy request.")
+                return
+            if row["accepted"]:
+                return
+            conn.execute("UPDATE wfc_buddies SET accepted=1 WHERE first_pid=? AND second_pid=?", pair)
+        with self._lock:
+            target = self._online.get(other)
+        self._authorized(client, other, target)
+
+    def _authorized(self, client: GameSpyHandler, other: int, target: GameSpyHandler | None) -> None:
+        pid = client.profile_id
+        self._send_buddy(client, 4, other, "")
+        self._send_buddy(target, 4, pid, "")
+        # The DS friend library consumes this legacy BM1 authorization notice, too.
+        notice = "I have authorized your request to add me to your list"
+        self._send_buddy(client, 1, other, notice)
+        self._send_buddy(target, 1, pid, notice)
+        self._exchange(pid, other, client)
+
+    def remove(self, client: GameSpyHandler, other: int) -> None:
+        pid = client.profile_id
+        with self.database.transaction() as conn:
+            changed = conn.execute("DELETE FROM wfc_buddies WHERE first_pid=? AND second_pid=?", sorted((pid, other)))
+        if changed.rowcount:
+            with self._lock:
+                target = self._online.get(other)
+            self._send_buddy(target, 6, pid, "")
+
+    def message(self, client: GameSpyHandler, other: int, kind: int, text: str) -> None:
+        if not self.are_buddies(client.profile_id, other):
+            client.send_error(0x901, "The destination is not a buddy.")
+            return
+        with self._lock:
+            target = self._online.get(other)
+        if target is None:
+            client.send_error(0x903, "The buddy is offline.")
+            return
+        if kind in (1, 5):
+            try:
+                text = rewrite_buddy_match(client.client_address[0], text)
+            except ValueError:
+                client.send_error(0x900, "Invalid DWC matching message.")
+                return
+        self._send_buddy(target, kind, client.profile_id, text)
