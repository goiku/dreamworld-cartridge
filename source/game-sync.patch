diff --git a/entralinked/network/matchmaking/addresses.py b/entralinked/network/matchmaking/addresses.py
new file mode 100644
index 0000000000000000000000000000000000000000..dde01d1ff5f5c898071da298c01a10be39fbdc76
--- /dev/null
+++ b/entralinked/network/matchmaking/addresses.py
@@ -0,0 +1,67 @@
+"""Map authenticated VPN relay endpoints to the address visible on the DS LAN."""
+import ipaddress
+import json
+import os
+from pathlib import Path
+
+_DEFAULT = Path(__file__).resolve().parents[5] / "outputs" / "DreamWorld-VPN-state.json"
+_RELAY = ipaddress.ip_network("127.64.0.0/10")
+
+
+def _relay_mapping(address):
+    if ipaddress.ip_address(address) not in _RELAY:
+        return None
+    try:
+        state = json.loads(Path(os.environ.get("DW_RELAY_STATE", str(_DEFAULT))).read_text("utf-8-sig"))
+        if state["version"] != 1:
+            return None
+        peer = state["peers"][address]
+        visible_ip = ipaddress.IPv4Address(state["relay_ip"])
+        if visible_ip.is_loopback or visible_ip.is_multicast or visible_ip.is_unspecified:
+            return None
+        return visible_ip, peer["udp_ports"]
+    except (KeyError, TypeError, ValueError, OSError):
+        pass
+    return None
+
+
+def visible_endpoint(endpoint, *, for_tcp=False):
+    address, port = endpoint
+    if ipaddress.ip_address(address) not in _RELAY:
+        return endpoint
+    mapping = _relay_mapping(address)
+    if mapping and (for_tcp or str(port) in mapping[1]):
+        return str(mapping[0]), port
+    return None
+
+
+def rewrite_match_data(source_ip, version, command, data):
+    """Publish reachable addresses in the DS reservation, acceptance and tell-address packets."""
+    if version not in (3, 11, 90) or command not in (1, 2, 6):
+        return data
+    mapping = _relay_mapping(source_ip)
+    if mapping is None:
+        return data
+    if command == 1:
+        offsets = (4, 12) if version == 90 else (4,)
+    elif command == 2:
+        offsets = (12, 20) if version == 90 else (4 + 4 * int.from_bytes(data[:4], "little"),)
+    elif len(data) == 8:
+        offsets = (0,)
+    else:
+        return data
+
+    relay, ports = mapping
+    result = bytearray(data)
+    for offset in offsets:
+        if offset + 8 > len(data):
+            continue
+        address = data[offset:offset + 4]
+        port = int.from_bytes(data[offset + 4:offset + 8], "little")
+        if address == relay.packed and str(port) in ports:
+            continue
+        mapped = next((int(outer) for outer, inner in ports.items() if inner == port), None)
+        if mapped is not None and 0 < mapped < 65536:
+            result[offset:offset + 4] = relay.packed
+            result[offset + 4:offset + 8] = mapped.to_bytes(4, "little")
+    return bytes(result)
