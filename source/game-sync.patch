+++ b/entralinked/network/gamespy/search.py
@@ -0,0 +1,64 @@
+"""GPSP searches use the live GPCM session and a separate unchallenged TCP connection."""
+import socketserver
+from typing import TYPE_CHECKING
+
+from .codec import TERMINATOR, decode_fields, encode_pairs
+
+if TYPE_CHECKING:
+    from .server import _ThreadedTCPServer
+
+
+class PlayerSearchHandler(socketserver.BaseRequestHandler):
+    server: "_ThreadedTCPServer"
+
+    def handle(self) -> None:
+        self.request.settimeout(20)
+        buffer = bytearray()
+        try:
+            while data := self.request.recv(4096):
+                buffer.extend(data)
+                if len(buffer) > 32768:
+                    raise ValueError
+                while TERMINATOR in buffer:
+                    frame, _, buffer = buffer.partition(TERMINATOR)
+                    command, _, fields = decode_fields(bytes(frame))
+                    self.request.sendall(encode_pairs(self.search(command, fields)))
+        except (ValueError, KeyError):
+            self.request.sendall(encode_pairs([("error", ""), ("err", 0xD00), ("errmsg", "Invalid profile search.")]))
+        except OSError:
+            return
+
+    def search(self, command: str, fields: dict[str, str]) -> list[tuple[str, str | int]]:
+        presence = self.server.context.presence
+        pid, key = int(fields["profileid"]), int(fields["sesskey"])
+        if not presence.search_authorized(pid, key, self.client_address[0]):
+            return [("error", ""), ("err", 0x201), ("errmsg", "Invalid session key.")]
+        if command == "otherslist":
+            requested = [int(n) for n in fields.get("opids", "").split("|") if n]
+            if len(requested) != int(fields.get("numopids", 0)) or len(requested) > 512:
+                raise ValueError
+            # Reverse buddy lookup returns the requested profiles which registered this player.
+            reverse = set(presence.reverse_buddies(pid))
+            response: list[tuple[str, str | int]] = [("otherslist", "")]
+            for other in dict.fromkeys(requested):
+                if other in reverse:
+                    for entry in presence.directory(other):
+                        response.extend([("o", other), ("uniquenick", entry.nick)])
+            return [*response, ("oldone", "")]
+        if command == "others":
+            response = [("others", "")]
+            for other in presence.reverse_buddies(pid):
+                for entry in presence.directory(other):
+                    response.extend([("o", other), ("nick", entry.nick), ("uniquenick", entry.nick)])
+            return [*response, ("odone", "")]
+        if command in ("search", "searchunique"):
+            criteria = {k: fields[k] for k in ("nick", "uniquenick", "firstname", "lastname", "email") if fields.get(k)}
+            response = []
+            if criteria:
+                for entry in presence.directory():
+                    values = {"nick": entry.nick, "uniquenick": entry.nick, "email": entry.nick + "@nds",
+                              "firstname": entry.profile.firstname or "", "lastname": entry.profile.lastname or ""}
+                    if all(values[k] == v for k, v in criteria.items()):
+                        response.extend([("bsr", entry.profile.id), *values.items()])
+            return [*response, ("bsrdone", ""), ("more", 0)]
+        raise ValueError
