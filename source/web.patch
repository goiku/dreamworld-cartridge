+{% if row.claim %}<form method="post" action="{{ url_for('campaigns.claim',key=row.key) }}">{{ fields() }}{% if row.event=='cafe' %}<label>{{ t.sex }} <select name="gender"><option value="1">♀</option><option value="0">♂</option></select></label>{% endif %} <button type="submit">{{ t.claim }}</button>{% if row.event=="berries" %} <button name="destination" value="chest">{{ t.chest }}</button>{% endif %}</form>{% elif row.number and row.status in ('queued','sent') %}<form method="post" action="{{ url_for('campaigns.claim',key=row.key) }}">{{ fields() }}<input type="hidden" name="next" value="1"><button>{{ t.prioritize }}</button></form>{% endif %}</li>{% else %}<li>{{ t.empty }}</li>{% endfor %}</ul>
+{% if pages>1 %}<nav class="gift-pages" aria-label="{{ page }} / {{ pages }}">{% if page>1 %}<a aria-label="{{ t.prev }}" href="{{ url_for(endpoint,kind=kind,filter=mode,page=page-1,q=search,version=version) }}">← {{ t.prev }}</a>{% endif %}<span>{{ page }} / {{ pages }}</span>{% if page<pages %}<a href="{{ url_for(endpoint,kind=kind,filter=mode,page=page+1,q=search,version=version) }}">{{ t.next }} →</a>{% endif %}</nav>{% endif %}{% endif %}
+<footer>{% if card and japanese %}<p><a href="/customize/">{{ t.customize }}</a></p>{% endif %}<a href="/languages/?page={{ url_for(endpoint) }}">Language · 日本語 · 简体中文</a></footer></main></body></html>
