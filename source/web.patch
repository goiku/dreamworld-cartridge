@@ -0,0 +1,101 @@
+<!doctype html>
+<html lang="{{ 'zh-CN' if lang == 'zh' else lang }}">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>{{ t.title }} · Pokémon Dream World</title>
+  <link rel="stylesheet" href="{{ url_for('player_guide.static', filename='player-guide.css') }}">
+  <script defer src="{{ url_for('player_guide.static', filename='player-guide.js') }}"></script>
+  <script type="module" src="{{ url_for('player_guide.static', filename='tuck-form.mjs') }}"></script>
+</head>
+<body class="dw-guide">
+  <header class="guide-header guide-toolbar">
+    {% include "guide_home_link.html" %}
+    <details class="guide-languages">
+      <summary>{{ language_names[lang] }}</summary>
+      <nav>{% for code, name in language_names.items() %}<a lang="{{ code }}" href="/languages/{{ code }}/?page=/player-guide/" {% if code == lang %}aria-current="page"{% endif %}>{{ name }}</a>{% endfor %}</nav>
+    </details>
+  </header>
+  <main class="guide-main">
+    <h1>{{ t.title }}</h1>
+    <nav class="guide-nav" aria-label="{{ t.title }}">
+      <a href="#dns">{{ t.dns_title }}</a><a href="{{ url_for('player_guide.phone') }}">{{ t.phone_title }}</a><a href="#console">{{ t.console_title }}</a>
+      <a href="#account">{{ t.account_title }}</a><a href="#register">{{ t.register_title }}</a><a href="#dream">{{ t.dream_title }}</a>
+      <a href="#tuck-in">{{ t.tuck_title }}</a><a href="#distributions">{{ gifts.title }}</a>
+      {% if arcade.instructions %}<a href="#minigames">{{ arcade.help_title }}</a>{% endif %}
+    </nav>
+    <section class="dns-card" id="dns" data-endpoint="{{ url_for('player_guide.dns') }}"
+             data-ready="{{ t.ready }}" data-offline="{{ t.offline }}" data-ambiguous="{{ t.ambiguous }}" data-emulator-offline="{{ t.emulator_offline }}" data-checking="{{ t.checking }}">
+      <h2>{{ t.dns_title }}</h2>
+      <label for="dns-device">{{ t.device }}</label>
+      <select id="dns-device" data-emulator="{{ url_for('player_guide.local_emulator_dns') }}">
+        <option value="console">{{ t.physical }}</option>
+        <option value="melonDS">{{ t.emulator }}</option>
+      </select>
+      <p id="emulator-guide" hidden>{{ t.emulator_steps }}</p>
+      <div role="status" aria-live="polite">
+        <p id="dns-message">{{ t.checking }}</p>
+        <output id="dns-address" hidden></output>
+      </div>
+      <div class="guide-actions">
+        <button id="refresh-dns" type="button">{{ t.refresh }}</button>
+        <button id="copy-dns" type="button" hidden data-copy="{{ t.copy }}" data-copied="{{ t.copied }}">{{ t.copy }}</button>
+      </div>
+      <noscript><a href="{{ url_for('player_guide.dns') }}">{{ t.physical }}</a> · <a href="{{ url_for('player_guide.local_emulator_dns') }}">{{ t.emulator }}</a></noscript>
+      <p class="guide-note"><a href="{{ url_for('player_guide.phone') }}">{{ t.phone_title }}</a></p>
+    </section>
+    <section id="console">
+      <h2>{{ t.console_title }}</h2>
+      {% for key, name in [('ds','Nintendo DS / DS Lite'),('dsi','Nintendo DSi / DSi XL'),('three_ds','Nintendo 3DS / 2DS')] %}
+      <details class="console-model"><summary>{{ name }}</summary><p>{{ t[key] }}</p></details>
+      {% endfor %}
+      <p class="guide-note">{{ t.console_note }}</p>
+    </section>
+    <section id="account">
+      <h2>{{ t.account_title }}</h2><p>{{ t.account }}</p>
+      <div class="guide-actions"><a href="{{ url_for('signup.trainer_club_signup', locale=lang) }}">{{ t.open_signup }}</a>
+      <a href="/login/pgl.html">{{ t.open_login }}</a></div>
+      <details class="console-model"><summary>{{ t.visit_title }}</summary><p>{{ t.visit }}</p>
+        <p><a href="https://github.com/goiku/dreamworld-cartridge/blob/main/{{ 'docs/README.zh-CN.md' if lang == 'zh' else ('docs/README.ja.md' if lang == 'ja' else 'README.md') }}">{{ t.details }} (GitHub)</a></p>
+      </details>
+    </section>
+    <section id="register"><h2>{{ t.register_title }}</h2><p>{{ t.register }}</p></section>
+    <section id="tuck-in">
+      <h2>{{ t.tuck_title }}</h2>
