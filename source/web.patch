+"""The Pokémon Global Link Dream Pal rosters and their profile links."""
+from flask import session
+
+from api.routes import Query, endpoint
+from game_sync_server.entralinked.utility.db_manager import db
+from utils import save_data, text, visits
+from utils.account_manager import accounts
+from utils.messages import message
+
+
+def current_save() -> str | None:
+    """Only use the Game Sync ID linked to the signed-in player."""
+    gscd = session.get("gscd")
+    username = session.get("username")
+    if username and gscd and accounts.get_gscd_owner(gscd) == username:
+        return gscd
+    return None
+
+
+def _target(query: Query) -> str | None:
+    raw = query.get("friend_member_savedata_id", "")
+    if not raw.isascii() or not raw.isdigit() or len(raw) > 18:
+        return None
+    return db.find_gscd(int(raw))
+
+
+def profile_target(query: Query, *, dream_world: bool = False, roster: bool = False) -> str | None:
+    viewer = current_save()
+    target = _target(query)
+    if not viewer or not target or not visits.published(target, viewer, dream_world=False):
+        return None
+    if dream_world and not visits.published(target, viewer, dream_world=True, roster=roster):
+        return None
+    return target
+
+
+def _nonnegative(query: Query, field: str, default: int) -> int:
+    try:
+        return max(0, int(query.get(field, default)))
+    except ValueError:
+        return default
+
+
+def _list(query: Query, relation: visits.PalStatus, *, visiting: bool = False) -> dict:
+    viewer = current_save()
+    subject = profile_target(query, dream_world=True, roster=True) if visiting else viewer
+    if not viewer or not subject:
+        return {"cnt": 0, "list": []}
+
+    rows = db.read_rows(
+        """SELECT CASE WHEN left_gscd=? THEN right_gscd ELSE left_gscd END AS other, requester
+           FROM dream_pals WHERE (left_gscd=? OR right_gscd=?) AND accepted=? ORDER BY rowid DESC""",
+        subject, subject, subject, relation == visits.PalStatus.FRIEND)
+    entries: list[dict] = []
+    for row in rows:
+        if relation == visits.PalStatus.INVITED and row["requester"] != subject:
+            continue
+        if relation == visits.PalStatus.INVITED_YOU and row["requester"] == subject:
+            continue
+        other = row["other"]
+        visible = visits.published(other, viewer, dream_world=False) and visits.published(other, viewer, dream_world=True)
+        if visiting and not visible:
+            continue
+        member = save_data.read_member(other)
+        if not member or not member.get("pgl_name"):
+            continue
+        entries.append({
+            "member_savedata_id": str(member["member_savedata_id"]),
+            "pgl_name": member["pgl_name"],
+            "avator_id": member.get("avator_id", 4),
+            "country_code": (text.lookup_str("country", member.get("country_id")) or "") if visible else "",
+            "disable_flag": "0" if visible else "1",
+            "is_ds": False,
+        })
+
+    if query.get("sort") == "2":
+        entries.sort(key=lambda entry: (entry["pgl_name"].casefold(), entry["member_savedata_id"]))
+    if query.get("dir") == "1":
+        entries.reverse()
+    offset = _nonnegative(query, "offset", 0)
+    count = _nonnegative(query, "rowcount", 5)
+    return {"cnt": len(entries), "list": entries[offset:offset + count]}
+
+
+@endpoint("pgl.member.profile.pdw_friend_list")
+def dream_pals(query: Query) -> dict:
+    return _list(query, visits.PalStatus.FRIEND)
+
+
+@endpoint("pgl.member.profile.pdw_friend_requesting_list")
+def sent_requests(query: Query) -> dict:
+    return _list(query, visits.PalStatus.INVITED)
+
+
+@endpoint("pgl.member.profile.pdw_friend_requested_list")
+def received_requests(query: Query) -> dict:
+    return _list(query, visits.PalStatus.INVITED_YOU)
+
+
+@endpoint("pgl.member.profile.friend_pdw_friend_list")
+def visited_dream_pals(query: Query) -> dict:
+    return _list(query, visits.PalStatus.FRIEND, visiting=True)
+
+
+def _remove(query: Query, *, accepted: bool) -> dict:
+    viewer = current_save()
+    other = _target(query)
+    if not viewer or not other or other == viewer:
+        return {"error": {"details": {"friend": message("unavailable_invitation")}}}
+    left, right = sorted((viewer, other))
+    with db.transaction() as conn:
+        # Only the sender can withdraw a pending invitation. Either pal can end a friendship.
+        conn.execute("""DELETE FROM dream_pals WHERE left_gscd=? AND right_gscd=?
+                        AND accepted=? AND (accepted=1 OR requester=?)""", (left, right, accepted, viewer))
+    return {}
+
+
+@endpoint("pgl.member.profile.pdw_friend_delete", methods=("POST",))
+def remove_pal(query: Query) -> dict:
+    return _remove(query, accepted=True)
+
+
+@endpoint("pgl.member.profile.pdw_friend_requesting_discard", methods=("POST",))
+def withdraw_request(query: Query) -> dict:
+    return _remove(query, accepted=False)
