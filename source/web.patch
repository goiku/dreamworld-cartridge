+    if kind == 1:
+        current = _traded_counts(None)
+        undated = db.read_rows("""SELECT 1 FROM gts_journal LEFT JOIN gts_profile_events ON trade_id=id
+                                  WHERE trade_id IS NULL LIMIT 1""")
+        previous = {} if undated else _traded_counts(cutoff)
+    else:
+        current = _offer_counts(kind, None)
+        previous = _offer_counts(kind, cutoff)
+    old_ranks = {species: rank for rank,species in enumerate(_ordered(previous), 1)}
+    return [{"monsno": species, "rank": rank, "old_rank": old_ranks.get(species)}
+            for rank,species in enumerate(_ordered(current)[offset:offset+limit], offset+1)]
+
+
+def _ratios(counts: Counter) -> list:
+    total = counts.total()
+    return [{"monsno": species, "ratio": 100 * counts[species] / total} for species in _ordered(counts)[:10]]
+
+
+@endpoint("gts.journal.poke_detail_data")
+def pokemon_details(query: Query) -> dict:
+    species = _number(query, "pokename_id", 1, 649)
+    offers = db.read_rows("SELECT record FROM gts_slots WHERE state='listed' AND species=? ORDER BY id DESC LIMIT 60", species)
+    total = db.read_rows("SELECT COUNT(*) FROM gts_slots WHERE state='listed' AND species=?", species)[0][0]
+    traded = db.read_rows("""WITH trades(a,b) AS (
+        SELECT json_extract(side_a,'$.monsno'),json_extract(side_b,'$.monsno') FROM gts_journal)
+        SELECT partner,COUNT(*) FROM (SELECT b AS partner FROM trades WHERE a=? UNION ALL
+        SELECT a FROM trades WHERE b=?) GROUP BY partner""", species, species)
+    wanted = db.read_rows("""SELECT species,COUNT(*) FROM gts_offer_activity
+                             WHERE closed_at IS NULL AND wanted_le=? GROUP BY species""", species.to_bytes(2,"little"))
+    return {"monsno": species, "gts_keep_count": total, "gts_keep_list": [_public_offer(row[0]) for row in offers],
+            "traded_ranking_data": _ratios(Counter(dict(traded))), "want_ranking_data": _ratios(Counter(dict(wanted)))}
+
+
+@endpoint("gts.journal.area_detail_data")
+def area_details(query: Query) -> dict:
+    """Count confirmed outgoing Pokémon, active offers and distinct GTS profiles in this country."""
     areas = load_areas()
-    return {"trade_list": [{"trade1": _random_trade_side(areas), "trade2": _random_trade_side(areas)}
-                           for _ in range(100)]}
+    raw = query.get("country_id", "")
+    if not raw.isascii() or not raw.isdigit() or len(raw) > 3 or int(raw) not in areas:
+        raise BadRequest("Unknown GTS country.")
+    country = int(raw)
+    ranked = db.read_rows("""WITH sides(data) AS (
+            SELECT side_a FROM gts_journal UNION ALL SELECT side_b FROM gts_journal)
+        SELECT json_extract(data,'$.monsno') AS species, COUNT(*) AS n FROM sides
+        WHERE json_extract(data,'$.country_id')=? GROUP BY species ORDER BY n DESC,species LIMIT 5""", country)
+    profiles = {}
+    participations = db.read_rows("""WITH sides(trade_id,pid,data) AS (
+          SELECT trade_id,pid_a,details_a FROM gts_profile_events UNION ALL
+          SELECT trade_id,pid_b,details_b FROM gts_profile_events)
+        SELECT pid,json_extract(data,'$.version') AS version FROM sides
+        WHERE json_extract(data,'$.country_id')=? ORDER BY trade_id""", country)
+    for entry in participations:
+        profiles[entry["pid"]] = entry["version"]
+    deposits = db.read_rows("""SELECT owner,record FROM gts_slots
+                               WHERE state='listed' AND country=? ORDER BY id DESC""", country)
+    recent = []
+    for row in deposits:
+        record = row["record"]
+        profiles[row["owner"]] = record[0x124]
+        if len(recent) < 60:
+            recent.append(_public_offer(record))
+    versions = Counter(version for version in profiles.values() if version in (20,21,22,23))
+    # The archive provides geography and time zones, but not those historic demographic counts.
+    return {"country_name": _country_name(country, areas), "capital": "—", "area_size": "—",
+            "population": "—", "netuser": "—", "visitor": "—", "total_rate": versions,
+            "total_count": len(profiles), "gts_keep_count": len(deposits),
+            "traded_ranking_data": [row["species"] for row in ranked], "gts_keep_pokemon_list": recent}
+
+
+def _pokemon(side: dict) -> dict:
+    fields = {key: side[key] for key in ("monsno", "form_no", "poke_level", "sex")}
+    fields["pokename"] = text.lookup_str("pokemon", side["monsno"])
+    fields["pokeitem"] = text.lookup_str("item", side["item"]) if side["item"] else ""
+    for index, move in enumerate(side["moves"], 1):
+        fields[f"waza{index}"] = (text.lookup_str("move", move) or "") if move else ""
+    return fields
+
+
+def _history_row(event, owner_pid: int, viewer: str, own_page: bool) -> dict:
+    mine, theirs = ("a", "b") if event["pid_a"] == owner_pid else ("b", "a")
+    given, received = (json.loads(event["details_" + side]) for side in (mine, theirs))
+    result = {**_pokemon(given), **{"trade_" + key: value for key, value in _pokemon(received).items()},
+              "trade_date": datetime.fromtimestamp(event["traded_at"], save_data.JST).strftime("%Y-%m-%d"),
+              "avator_id": None, "pgl_name": "", "player_name": "", "country": ""}
+    resolved = db.read_rows("""SELECT m.gscd FROM wfc_cartridge_profiles m JOIN wfc_profile_keys p ON p.pid=m.pid
+                               WHERE m.pid=? AND p.identity=?""", event["pid_" + theirs], event["key_" + theirs])
+    # The cartridge disclosed its trainer name directly to the exchange partner.
+    # Other viewers only get identifying information from a published partner profile.
+    visible = bool(resolved) and visits.published(resolved[0]["gscd"], viewer, dream_world=False)
+    if own_page or visible:
+        result.update(player_name=received["trainer"], country=_country_name(received["country_id"], load_areas()))
+    if visible:
+        member = save_data.read_member(resolved[0]["gscd"])
+        result.update(avator_id=member.get("avator_id"), pgl_name=member.get("pgl_name", ""))
+    return result
+
+
+@endpoint("gts.profile.gts_history")
+def trade_history(query: Query) -> dict:
+    now = datetime.now(save_data.JST)
+    data = {"last_batchtime": {"yyyy": now.year, "mm": now.strftime("%m"), "dd": now.strftime("%d"),
+                               "hh": now.strftime("%H"), "mi": now.strftime("%M")},
+            "trade_history": [], "bookmark_list": []}
+    viewer = current_save()
+    target = viewer
+    if viewer and "member_savedata_id" in query:
+        target = profile_target({"friend_member_savedata_id": query["member_savedata_id"]})
+    if not viewer or not target:
+        return data
+    data["bookmark_list"] = save_data.read_player_data(target).get("gts_bookmarks", [])
+    matches = db.read_rows("""SELECT m.pid,k.identity FROM wfc_cartridge_profiles m
+                              JOIN wfc_profile_keys k ON k.pid=m.pid WHERE m.gscd=?""", target)
+    if not matches:
+        return data
+    pid, key = matches[0]
+    events = db.read_rows("""SELECT * FROM gts_profile_events WHERE
+        (pid_a=? AND key_a=?) OR (pid_b=? AND key_b=?) ORDER BY trade_id DESC LIMIT 5""", pid, key, pid, key)
+    data["trade_history"] = [_history_row(row, pid, viewer, target == viewer) for row in events]
+    active = db.read_rows("""SELECT slots.record FROM gts_slots slots JOIN gts_listing_identity i ON i.slot=slots.id
+                             WHERE slots.owner=? AND i.identity=? AND slots.state IN ('listed','reserved')""", pid, key)
+    if active:
+        record = active[0]["record"]
+        species, sex, low, high = struct.unpack_from("<HBBB", record, 0xf0)
+        year, month, day = struct.unpack_from("<HBB", record, 0xf8)
+        data["gts_pokemon"] = {**_pokemon(private_summary(record)), "post_date": f"{year:04}-{month:02}-{day:02}",
+                               "sex_type": record[0xee]}
+        data["want_pokemon"] = {"monsno": species, "pokename": text.lookup_str("pokemon", species), "sex_type": sex,
+                                "poke_level_min": low, "poke_level_max": high}
+    return data
+
+
+def _bookmark(query: Query, add: bool) -> dict:
+    code = current_save()
+    if not code:
+        raise Forbidden()
+    raw = query.get("pokename_id", "")
+    if not raw.isascii() or not raw.isdigit() or len(raw) > 3 or not 1 <= int(raw) <= 649:
+        raise BadRequest("Unknown Pokémon species.")
+    species = int(raw)
+    def change(data):
+        saved = set(data.get("gts_bookmarks", []))
+        if add:
+            saved.add(species)
+        else:
+            saved.discard(species)
+        data["gts_bookmarks"] = sorted(saved)
+    db.update(code, "player_data", change)
+    return {}
+
+
+@endpoint("gts.journal.add_bookmark", methods=("GET", "POST"))
+def add_bookmark(query: Query) -> dict:
+    return _bookmark(query, True)
+
+
+@endpoint("gts.journal.delete_bookmark", methods=("GET", "POST"))
+def delete_bookmark(query: Query) -> dict:
+    return _bookmark(query, False)
