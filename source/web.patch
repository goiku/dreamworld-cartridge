diff --git a/static/pwt-save.mjs b/static/pwt-save.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..22a9a22b4f60e4eed8cc262b51139a9bf143cc82
--- /dev/null
+++ b/static/pwt-save.mjs
@@ -0,0 +1,55 @@
+// B2/W2 extdata layout and CRCs follow PKHeX SAV5B2W2.SetPWT and PlayerData5B2W2.
+const TRAINER = 0x19400, TABLE = 0x25f00, DATA = 0x1214, BLOCK = 0x1314;
+const view = bytes => new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength);
+export function crc(bytes) {
+    let value = 0xffff;
+    for (const byte of bytes) {
+        value ^= byte << 8;
+        for (let bit=0; bit<8; bit++)
+            value = ((value << 1) ^ ((value & 0x8000) ? 0x1021 : 0)) & 0xffff;
+    }
+    return value;
+}
+function checksummed(bytes,start,size) {
+    return crc(bytes.subarray(start,start+size));
+}
+function validTournament(block) {
+    if (block.length!==BLOCK) return false;
+    const v=view(block),sum=checksummed(block,0,DATA);
+    return v.getUint16(DATA,true)===1 && v.getUint16(DATA+2,true)===sum
+        && v.getUint32(0x1300,true)===sum && v.getUint32(0x1304,true)===1
+        && v.getUint32(0x1308,true)===BLOCK && v.getUint32(0x130c,true)===0x31053527
+        && v.getUint16(0x1312,true)===checksummed(block,0x1300,4);
+}
+export function inspect(bytes) {
+    if (bytes.length!==0x80000 || bytes[TRAINER+0x1e]!==1 || ![22,23].includes(bytes[TRAINER+0x1f]))
+        throw Error("invalid");
+    const v=view(bytes),sum=checksummed(bytes,TRAINER,0xb0);
+    if (sum!==v.getUint16(0x194b2,true) || sum!==v.getUint16(0x25f36,true)
+        || checksummed(bytes,TABLE,0x94)!==v.getUint16(0x25fa2,true)) throw Error("invalid");
+    return [0,1,2].map(index=>{
+        const offset=0x7a000+index*0x1400,flag=v.getUint16(TRAINER+0x52+index*2,true);
+        const block=bytes.subarray(offset,offset+BLOCK);
+        const empty = flag===0 && v.getUint32(TRAINER+0xa0+index*4,true)===0
+            && (block.every(b=>b===0) || block.every(b=>b===255));
+        return {offset,empty,number:flag===0xc21e?v.getUint16(offset+8,true):null,
+                crc:checksummed(block,0,DATA)};
+    });
+}
+export function install(bytes,block) {
+    const slots=inspect(bytes);
+    if (!validTournament(block)) throw Error("unavailable");
+    const number=view(block).getUint16(8,true);
+    if (slots.some(slot=>slot.number===number)) throw Error("already");
+    const index=slots.findIndex(slot=>slot.empty);
+    if (index<0) throw Error("full");
+    const updated=bytes.slice(),v=view(updated);
+    updated.set(block,slots[index].offset);
+    v.setUint16(TRAINER+0x52+2*index,0xc21e,true);
+    v.setUint32(TRAINER+0xa0+4*index,1,true);
+    const sum=checksummed(updated,TRAINER,0xb0);
+    v.setUint16(0x194b2,sum,true);
+    v.setUint16(0x25f36,sum,true);
+    v.setUint16(0x25fa2,checksummed(updated,TABLE,0x94),true);
+    return updated;
+}
diff --git a/static/tournaments.mjs b/static/tournaments.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..96c59ee944d4d84fa6585947afa26952ca61bec5
--- /dev/null
+++ b/static/tournaments.mjs
@@ -0,0 +1,51 @@
+import {install,inspect} from "./pwt-save.mjs";
+const t=JSON.parse(document.getElementById("text").textContent);
+const picker=document.getElementById("save"), message=document.getElementById("message");
+const copy=document.getElementById("copy"), buttons=[...document.querySelectorAll("button[data-number]")];
+let current=null, generation=0, busy=false;
+function render() {
+    const slots=current?inspect(current):[];
+    for (const button of buttons) {
+        const found=slots.find(slot=>slot.number===Number(button.dataset.number));
+        button.hidden=!current;
+        button.disabled=busy || !!found || !slots.some(slot=>slot.empty);
+        button.textContent=found?(found.crc===Number(button.dataset.crc)?t.installed:t.related):t.add;
+    }
+}
+function discardCopy() {
+    if (copy.href) URL.revokeObjectURL(copy.href);
+    copy.removeAttribute("href");
+    copy.hidden=true;
+}
+picker.addEventListener("change",async()=>{
+    const file=picker.files[0],id=++generation;
+    discardCopy(); current=null; busy=false; message.textContent=""; render();
+    if (!file) return;
+    try {
+        if(file.size!==0x80000) throw Error("invalid");
+        const data=new Uint8Array(await file.arrayBuffer());
+        const slots=inspect(data);
+        if (id!==generation) return;
+        current=data;
+        message.textContent=slots.some(slot=>slot.empty)?t.ready:t.full;
+    } catch {if(id===generation) message.textContent=t.invalid;}
+    render();
+});
+for (const button of buttons) button.addEventListener("click",async()=>{
+    if (!current || busy) return;
+    const id=generation;
+    busy=true; render(); message.textContent=t.loading;
+    try {
+        const res=await fetch(button.parentElement.querySelector("a").href);
+        if(!res.ok) throw Error("unavailable");
+        const block=new Uint8Array(await res.arrayBuffer());
+        if(id!==generation) return;
+        const updated=install(current,block);
+        discardCopy();
+        copy.href=URL.createObjectURL(new Blob([updated],{type:"application/octet-stream"}));
+        copy.download=picker.files[0].name.replace(/\.sav$/i,"")+"-PWT.sav";
+        copy.hidden=false;
+        current=updated; message.textContent=t.saved; copy.click();
+    } catch(error) {if(id===generation) message.textContent=t[error.message] || t.unavailable;}
+    finally {if(id===generation){busy=false;render();}}
+});
diff --git a/static/tuck-form.mjs b/static/tuck-form.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f59fc3aada0182551dab5dd0ab5e77c2d8fbafa0
--- /dev/null
+++ b/static/tuck-form.mjs
@@ -0,0 +1,121 @@
+import {prepareTuckSave} from "./tuck-save.mjs";
+
+const el = id => document.getElementById("tuck-" + id);
+const labels = JSON.parse(el("labels").textContent);
+const date = el("date"), picker = el("file"), folderButton = el("folder"), list = el("list");
+const write = el("write"), download = el("download"), status = el("status");
+const now = new Date();
+date.value = [now.getFullYear(), String(now.getMonth()+1).padStart(2, "0"), String(now.getDate()).padStart(2, "0")].join("-");
+folderButton.hidden = !window.showDirectoryPicker;
+let directory, handle, selected, original, prepared, generation = 0;
+
+function reset() {
+    generation++;
+    original = prepared = null;
+    if (download.href) URL.revokeObjectURL(download.href);
+    download.removeAttribute("href");
+    download.hidden = write.hidden = true;
+    status.textContent = "";
+    return generation;
+}
+async function inspect() {
+    const id = reset();
+    if (!selected && !handle) return;
+    try {
+        const file = handle ? await handle.getFile() : selected;
+        if (file.size !== 0x80000) throw Error("invalid");
+        const data = new Uint8Array(await file.arrayBuffer());
+        if (id !== generation) return;
+        const result = prepareTuckSave(data, date.value);
+        status.textContent = labels[result.status];
+        if (result.status !== "prepared") return;
+        original = data;
+        prepared = result.bytes;
+        download.download = file.name.replace(/\.sav$/i, "") + "-tuck-in.sav";
+        download.href = URL.createObjectURL(new Blob([prepared], {type: "application/octet-stream"}));
+        download.hidden = false;
+        write.hidden = !handle;
+    } catch (err) {
+        if (id === generation) status.textContent = labels[err.message] || labels.invalid;
+    }
+}
+function busy(value) {
+    for (const input of [picker, date, list, folderButton, write]) input.disabled = value;
+}
+picker.onchange = () => {
+    directory = handle = null;
+    list.hidden = true;
+    selected = picker.files[0];
+    inspect();
+};
+date.oninput = inspect;
+folderButton.onclick = async () => {
+    busy(true);
+    try {
+        const folder = await window.showDirectoryPicker({mode: "readwrite", id: "dream-world-saves"});
+        reset();
+        directory = folder;
+        selected = handle = null;
+        picker.value = "";
+        list.replaceChildren(new Option(labels.file, ""));
+        list.hidden = true;
+        const names = [];
+        for await (const [name, entry] of folder.entries()) {
+            if (entry.kind === "file" && /\.sav$/i.test(name)) names.push(name);
+        }
+        for (const name of names.sort()) list.add(new Option(name, name));
+        list.hidden = !names.length;
+        if (!names.length) status.textContent = labels.empty;
+        if (names.length === 1) {
+            list.value = names[0];
+            handle = await folder.getFileHandle(list.value);
+            await inspect();
+        }
+    } catch (err) {
+        if (err.name !== "AbortError") status.textContent = labels.access;
+    } finally { busy(false); }
+};
+list.onchange = async () => {
+    reset();
+    handle = null;
+    busy(true);
+    try {
+        if (list.value) handle = await directory.getFileHandle(list.value);
+        await inspect();
+    } catch { status.textContent = labels.access; }
+    finally { busy(false); }
+};
+async function put(file, bytes) {
+    const stream = await file.createWritable({mode: "exclusive"});
+    try { await stream.write(bytes); await stream.close(); }
+    catch (err) { await stream.abort().catch(() => {}); throw err; }
+}
+write.onclick = async () => {
+    if (!handle || !prepared || write.disabled) return;
+    busy(true);
+    let stream, backupName;
+    try {
+        stream = await handle.createWritable({mode: "exclusive"});
+        const current = new Uint8Array(await (await handle.getFile()).arrayBuffer());
+        if (current.length !== original.length || !original.every((v, i) => current[i] === v)) {
+            await stream.abort();
+            stream = null;
+            await inspect();
+            status.textContent = labels.changed;
+            return;
+        }
+        backupName = handle.name + "." + crypto.randomUUID() + ".bak";
+        const backup = await directory.getFileHandle(backupName, {create: true});
+        await put(backup, original);
+        const savedBackup = new Uint8Array(await (await backup.getFile()).arrayBuffer());
+        if (savedBackup.length !== original.length || !savedBackup.every((v, i) => v === original[i])) throw Error();
+        await stream.write(prepared);
+        await stream.close();
+        stream = null;
+        reset();
+        status.textContent = labels.done.replace("{file}", backupName);
+    } catch {
+        if (stream) await stream.abort().catch(() => {});
+        status.textContent = labels.access;
+    } finally { busy(false); }
+};
diff --git a/static/tuck-save.mjs b/static/tuck-save.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..860d8dabbeff822a222277080cfb2b09bee70d5c
--- /dev/null
+++ b/static/tuck-save.mjs
@@ -0,0 +1,62 @@
+import {crc} from "./pwt-save.mjs";
+
+const DAY = 86400000;
+function checkedDate(year, month, day) {
+    const value = new Date(Date.UTC(year, month - 1, day));
+    if (year < 2000 || year > 2099 || value.getUTCFullYear() !== year ||
+        value.getUTCMonth() !== month - 1 || value.getUTCDate() !== day) throw Error("date");
+    return value;
+}
+const ordinal = date => (date.getTime() - Date.UTC(date.getUTCFullYear(), 0, 1)) / DAY;
+
+export function prepareTuckSave(original, dateText) {
+    if (!(original instanceof Uint8Array) || original.length !== 0x80000) throw Error("invalid");
+    if (!/^\d{4}-\d\d-\d\d$/.test(dateText)) throw Error("date");
+    const today = checkedDate(...dateText.split("-").map(Number));
+    const yesterday = today.getTime() === Date.UTC(2000, 0, 1)
+        ? new Date(Date.UTC(2099, 11, 31)) : new Date(today.getTime() - DAY);
+    const game = original[0x1941f];
+    if (![20, 21, 22, 23].includes(game)) throw Error("invalid");
+    const [stride, table, tableSize, tableSum, trainerSize] = game >= 22
+        ? [0x26000, 0x25f00, 0x94, 0x25fa2, 0xb0] : [0x24000, 0x23f00, 0x8c, 0x23f9a, 0x68];
+    const bytes = new Uint8Array(original);
+    let changed = false, awake = false;
+    for (const base of [0, stride]) {
+        const slot = bytes.subarray(base, base + stride);
+        if (base && (slot.every(x => x === 0) || slot.every(x => x === 255))) continue;
+        const view = new DataView(slot.buffer, slot.byteOffset, slot.byteLength);
+        const sum = (pos, len) => crc(slot.subarray(pos, pos + len));
+        const blocks = [[0x19400, trainerSize, 54], [0x1d300, 0x1ac, 70], [0x1d900, 0x5c, 74]];
+        if (slot[0x1941f] !== game || sum(table, tableSize) !== view.getUint16(tableSum, true)) throw Error("invalid");
+        for (const [pos, len, mirror] of blocks) {
+            const check = sum(pos, len);
+            if (view.getUint16(pos + len + 2, true) !== check || view.getUint16(table + mirror, true) !== check)
+                throw Error("invalid");
+        }
+        const wait = view.getUint32(0x1d944, true);
+        if (wait > 1440) throw Error("invalid");
+        if (slot[0x1d4a3]) continue;
+        awake = true;
+        const [weekday, day, month, year] = slot.subarray(0x1d300, 0x1d304);
+        let lastDay = 0;
+        if (!(weekday === 0 && day === 1 && month === 1 && year === 0xda)) {
+            if (weekday > 6) throw Error("invalid");
+            try { lastDay = ordinal(checkedDate(2000 + year, month, day)); }
+            catch { throw Error("invalid"); }
+        }
+        if (lastDay !== ordinal(today) && !wait) continue;
+        if (lastDay === ordinal(today)) {
+            slot.set([yesterday.getUTCDay(), yesterday.getUTCDate(), yesterday.getUTCMonth() + 1,
+                yesterday.getUTCFullYear() - 2000], 0x1d300);
+        }
+        view.setUint32(0x1d944, 0, true);
+        for (const [pos, len, mirror] of blocks.slice(1)) {
+            const check = sum(pos, len);
+            view.setUint16(pos + len + 2, check, true);
+            view.setUint16(table + mirror, check, true);
+        }
+        view.setUint16(tableSum, sum(table, tableSize), true);
+        changed = true;
+    }
+    return {bytes, status: changed ? "prepared" : awake ? "ready" : "asleep"};
+}
diff --git a/templates/customize.html b/templates/customize.html
new file mode 100644
index 0000000000000000000000000000000000000000..b919bedcdf02236e3046a8d15e8785baf233c2bb
--- /dev/null
+++ b/templates/customize.html
@@ -0,0 +1,45 @@
+<!doctype html>
+<html lang="{{ 'zh-CN' if lang == 'zh' else lang }}">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{{ t.title }} · Pokémon Global Link</title>
+<style>
+*{box-sizing:border-box}body{margin:0;color:#23372e;background:#f6f6ed;font:1rem/1.5 system-ui,sans-serif}
+main{max-width:66rem;margin:auto;padding:1rem}a{color:#245841}h1{margin:.85rem 0 .5rem;line-height:1.2}
+nav{display:flex;gap:.5rem;flex-wrap:wrap}.links{justify-content:space-between}
+.tabs{margin:1rem 0}.tabs a,button{padding:.5rem 1rem;border:1px solid #668779;border-radius:.4rem}
+.tabs [aria-current],button{background:#315c49;color:white}.tabs a{text-decoration:none}button{cursor:pointer;font:inherit}
+fieldset{min-width:0;border:0;padding:0;margin:0}legend{font-weight:650;font-size:1.2rem;margin-bottom:.5rem}
+.choices{display:grid;gap:.65rem;grid-template-columns:repeat(auto-fill,minmax(min(100%,9.4rem),1fr))}
+.choice{background:white;border:1px solid #bccabe;border-radius:.45rem;padding:.6rem;display:flex;align-items:center;gap:.45rem;cursor:pointer}
+.choice:has(:checked){outline:2px solid #376950;outline-offset:-2px;background:#edf5e8}
+.choice img{display:block;width:100%;height:4.8rem;object-fit:contain}.choice span{min-width:0;overflow-wrap:anywhere}
+.entry{display:grid}.entry audio{width:100%}
+input{accent-color:#315c49}.actions{position:sticky;bottom:0;background:#f6f6ed;border-top:1px solid #bccabe;padding:.65rem 0;margin-top:1rem}
+[role=status]{background:#e0efdf;padding:.7rem;border-left:4px solid #376950}
+</style></head>
+<body><main>
+<nav class="links"><a href="/pdw/">← {{ guide.home }}</a><a href="/languages/?page=/customize/">Language</a></nav>
+<h1>{{ t.title }}</h1>
+{% if not card %}<p>{{ guide.login }}</p><a href="/">{{ t.login }}</a>
+{% elif not ready %}<p>{{ guide.sync }}</p>
+{% else %}
+<p>{{ t.wake }}</p>
+{% for notice in get_flashed_messages(category_filter=['customize']) %}<p role="status">{{ notice }}</p>{% endfor %}
+<nav class="tabs" aria-label="{{ t.title }}">
+{% for key in categories %}<a href="{{ url_for('.index', kind=key) }}"{% if key == category %} aria-current="page"{% endif %}>{{ t[key] }}</a>{% endfor %}
+</nav>
+<form method="post" action="{{ url_for('.index', kind=category) }}">
+<input type="hidden" name="csrf" value="{{ session.customize_csrf }}"><input type="hidden" name="card" value="{{ card }}">
+<fieldset><legend>{{ t[category] }}</legend>
+<div class="choices">
+{% for item in items %}
+<div class="entry"><label class="choice"><input type="radio" name="choice" value="{{ item.present_id }}"{% if item.is_select == '1' %} checked{% endif %}>
+<span>{% if item.preview %}<img src="{{ url_for('.preview',present_id=item.present_id) }}" alt="" loading="lazy">{% endif %}{{ item.present_name }}</span></label>
+{% if item.musical_file %}<audio controls preload="none" aria-label="{{ item.present_name }}" src="/src/swf/customize/assets/{{ asset_lang }}/img{{ item.musical_file }}"></audio>{% endif %}</div>
+{% endfor %}
+<label class="choice"><input type="radio" name="choice" value="none"{% if not selected %} checked{% endif %}>{{ t.none }}</label>
+</div></fieldset>
+<div class="actions"><button type="submit">{{ t.save }}</button></div>
+</form>{% endif %}
+</main></body></html>
diff --git a/templates/distribution_queue.html b/templates/distribution_queue.html
new file mode 100644
index 0000000000000000000000000000000000000000..0c63ffa73c0c92e15c666bc9d71882db22426826
--- /dev/null
+++ b/templates/distribution_queue.html
@@ -0,0 +1,52 @@
+<!doctype html>
+<html lang="{{ 'zh-CN' if lang == 'zh' else lang }}">
+<head>
+  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+  <title>{{ t.queue_title }} · Pokémon Dream World</title>
+  <link rel="stylesheet" href="{{ url_for('offline_friends.static', filename='island-friends.css') }}">
+  <style>
+    main{max-width:52rem;margin:1.5rem auto;padding:0 1rem}
+    nav{display:flex;flex-wrap:wrap;gap:1rem}section{margin:1.5rem 0}
+    ol,ul{padding-inline-start:2.5rem}li{padding:.45rem .25rem;border-bottom:1px solid #ccd8d0;overflow-wrap:anywhere}
+    li::marker{font-weight:bold}li form{display:inline-block;margin:.25rem .5rem}button{cursor:pointer}
+  </style>
+  <script defer src="{{ url_for('campaigns.static', filename='distribution-queue.js') }}"></script>
+</head>
+<body><main>
+  <nav><a href="{{ url_for('campaigns.index', kind='wonder') }}">← {{ t.title }}</a>
+    <a href="{{ url_for('campaigns.receiver_queue') }}">{{ t.queue_refresh }}</a>
+    <a href="/languages/?page=/campaign/queue/">Language</a></nav>
+  <h1>{{ t.queue_title }}</h1>
+  <div id="receiver-queue">
+    {% if not card %}<p>{{ t.login }}</p><a href="/">{{ t.home }}</a>
+    {% else %}
+    {% if warning %}<p>{{ t[warning] }}</p>{% endif %}
+    {% macro entries(keys, kind, numbered=true) %}
+      {% if numbered %}<ol>{% else %}<ul>{% endif %}
+      {% for key in keys %}{% set gift = catalog[key] %}
+        <li data-gift="{{ key }}">{% if gift.number %}#{{ gift.number }} · {% endif %}{{ gift_name(gift) }}
+          {% if kind == 'sent' or (kind == 'wonder' and not loop.first) %}
+          <form method="post" action="{{ url_for('campaigns.claim',key=key) }}">
+            <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="card" value="{{ card }}">
+            <input type="hidden" name="next" value="1"><input type="hidden" name="from_queue" value="1">
+            <button type="submit">{{ t.prioritize }}</button>
+          </form>{% endif %}
+        </li>
+      {% endfor %}
+      {% if numbered %}</ol>{% else %}</ul>{% endif %}
+    {% endmacro %}
+    <section id="wonder"><h2>{{ t.wonder }} ({{ groups.wonder|length }})</h2>
+      {% if groups.wonder %}<p>{{ t.queue_order }}</p>{{ entries(groups.wonder, 'wonder') }}
+      {% else %}<p>{{ t.queue_empty }}</p>{% endif %}
+    </section>
+    {% if groups.sent %}<section id="sent"><h2>{{ t.sent }} ({{ groups.sent|length }})</h2>
+      {{ entries(groups.sent,'sent',false) }}</section>{% endif %}
+    <section id="dream"><h2>{{ t.dream }}</h2>
+      {% if groups.wake %}<h3>{{ t.queue_wake }}</h3>{{ entries(groups.wake,'wake') }}{% endif %}
+      {% if groups.later %}<h3>{{ t.queue_later }}</h3>{{ entries(groups.later,'later') }}{% endif %}
+      {% if not groups.wake and not groups.later %}<p>{{ t.queue_empty }}</p>{% endif %}
+    </section>
+    {% endif %}
+  </div>
+  <p id="queue-error" role="status" hidden>{{ t.queue_stale }}</p>
+</main></body></html>
