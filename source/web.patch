new file mode 100644
index 0000000000000000000000000000000000000000..eedd4584cc13bb76d74327887fce9053818c39da
--- /dev/null
+++ b/scripts/activate_account.py
@@ -0,0 +1,20 @@
+"""Approve a registered Trainer Club account from the server console."""
+import argparse
+
+from utils.account_manager import accounts
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("username")
+    args = parser.parse_args()
+    account = accounts.get_account_by_username(args.username)
+    if not account:
+        parser.error("Account not found. Ask the player to complete sign-up first.")
+    if not account["activated"]:
+        accounts.activate_account(account["activation_token"])
+    print(f"{account['username']} can now sign in.")
+
+
+if __name__ == "__main__":
+    main()
