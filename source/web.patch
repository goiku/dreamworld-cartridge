index 0000000000000000000000000000000000000000..41094694cfc6a19e56e83a6eaf673ad62da22672
--- /dev/null
+++ b/utils/zh_web.py
@@ -0,0 +1,98 @@
+"""Localize archived PGL documents while preserving their original navigation and form behavior."""
+import json
+import re
+from functools import cache, lru_cache
+from html import escape, unescape
+from html.parser import HTMLParser
+
+from config import ROOT_DIR
+
+
+@cache
+def _translations() -> dict[str, str]:
+    return json.loads((ROOT_DIR / "json_data" / "zh_web.json").read_text(encoding="utf-8"))
+
+
+def _translate(value: str) -> str:
+    key = " ".join(value.split())
+    translation = _translations().get(key)
+    if translation is None:
+        return value
+    return value[:len(value) - len(value.lstrip())] + translation + value[len(value.rstrip()):]
+
+
+_LABEL = re.compile(r"""(\s(?:alt|title|placeholder|aria-label)\s*=\s*)(["'])(.*?)\2""", re.I | re.S)
+_CHARSET = re.compile(r"(?i)(charset\s*=\s*[\x22\x27]?)(?:shift[_-]jis|windows-31j|x-sjis|sjis|cp932)")
+_LANG = re.compile(r"""\s(?:xml:)?lang\s*=\s*["'][^"']*["']""", re.I)
+
+
+class _Document(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.parts: list[str] = []
+        self.verbatim = ""
+
+    def _tag(self, tag: str, raw: str) -> None:
+        if tag in ("script", "style"):
+            self.verbatim = tag
+        if tag == "html":
+            raw = _LANG.sub("", raw)
+            raw = raw[:-1] + ' lang="zh-CN">'
+        raw = _LABEL.sub(lambda m: m[1] + m[2] + escape(_translate(unescape(m[3])), quote=True) + m[2], raw)
+        self.parts.append(raw)
+
+    def handle_starttag(self, tag, attrs):
+        self._tag(tag, self.get_starttag_text())
+
+    def handle_startendtag(self, tag, attrs):
+        self._tag(tag, self.get_starttag_text())
+
+    def handle_endtag(self, tag):
+        if tag == self.verbatim:
+            self.verbatim = ""
+        if tag == "head":
+            self.parts.append('<link rel="stylesheet" href="/assets/global/zh/site.css">')
+            self.parts.append('<script defer src="/assets/global/zh/site.js"></script>')
+        self.parts.append(f"</{tag}>")
+
+    def handle_data(self, data):
+        if self.verbatim:
+            self.parts.append(data)
+        else:
+            self.parts.append(escape(_translate(data), quote=False))
+
+    def handle_entityref(self, name):
+        self.parts.append("&" + name + ";")
+
+    def handle_charref(self, name):
+        self.parts.append("&#" + name + ";")
+
+    def handle_comment(self, data):
+        if data == "zh-country-options":
+            names = (ROOT_DIR / "raw_text" / "zh" / "country.txt").read_text(encoding="utf-8-sig").splitlines()
+            self.parts.extend(f'<option value="{i}">{escape(name)}</option>' for i, name in enumerate(names) if name.strip())
+        elif data == "zh-month-options":
+            self.parts.extend(f'<option value="{i}">{i} 月</option>' for i in range(1, 13))
+        else:
+            self.parts.append("<!--" + data + "-->")
+
+    def handle_decl(self, data):
+        self.parts.append("<!" + data + ">")
+
+    def handle_pi(self, data):
+        self.parts.append("<?" + data + ">")
+
+    def unknown_decl(self, data):
+        self.parts.append("<![" + data + "]>")
+
+
+@lru_cache(maxsize=96)
+def localize_html(data: bytes) -> bytes:
+    try:
+        source = data.decode("utf-8-sig")
+    except UnicodeDecodeError:
+        source = data.decode("cp932", errors="replace")
+    parser = _Document()
+    parser.feed(_CHARSET.sub(r"\1utf-8", source))
+    parser.close()
+    return "".join(parser.parts).encode("utf-8")
