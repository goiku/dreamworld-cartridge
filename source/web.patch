+
+MAX_FAVORITES = 15
+VIDEO_NUMBER = re.compile(r"(?:[0-9]{12}|[0-9]{2}-[0-9]{5}-[0-9]{5})")
+
+
+def _list(codes: list[str]) -> dict:
+    return {"video_code": [{"video_code": code} for code in codes]}
