+    "GUF": "法属圭亚那", "GIB": "直布罗陀", "GLP": "瓜德罗普", "IMN": "马恩岛",
+    "LSO": "莱索托", "MKD": "北马其顿", "MTQ": "马提尼克", "KOR": "韩国",
+    "SMR": "圣马力诺", "SDN": "苏丹", "SWZ": "斯威士兰", "TCA": "特克斯和凯科斯群岛",
+    "VAT": "梵蒂冈", "ZWE": "津巴布韦", "SXM": "荷属圣马丁", "GGY": "根西岛",
+    "JEY": "泽西岛", "MSR": "蒙特塞拉特", "SRB": "塞尔维亚和科索沃",
+}
+
+
+def chinese_region_name(area: dict) -> str:
+    if area["iso3166"] == "-":
+        return {0: "无", 41: "海峡群岛", 107: "克什米尔"}.get(area["gts"], "")
+    if area["iso3166"] == "CUW":
+        return "荷属安的列斯" if area["gts"] == 146 else "库拉索"
+    region_id = 0 if area["iso3166"] == "JPN" else area["pgl"]
+    return (lookup_str("country", region_id) if region_id is not None else None) or _GTS_REGIONS.get(
+        area["iso3166"], area["names"].get("ja", ""))
+
+
+def localize_report_catalog(data: bytes, filename: str) -> bytes:
+    if filename == "pokemons.js":
+        def pokemon(match: re.Match) -> bytes:
+            name = lookup_str("pokemon", int(match[1]))
+            return match[0] if not name else b"zh:" + json.dumps(name).encode() + b"," + match[0]
+        return re.sub(rb"\bpokedex:(\d+)", pokemon, data)
+
+    def region(match: re.Match) -> bytes:
+        pgl, gts, iso = match.groups()
+        area = {"pgl": json.loads(pgl), "gts": json.loads(gts), "iso3166": iso.decode(), "names": {}}
+        name = chinese_region_name(area)
+        return match[0] + b"zh:" + json.dumps(name).encode() + b","
+    return re.sub(rb'pgl:(\d+|null),gts:(\d+|null),iso3166:"([^"]+)",has_detail:\w+,names:\{', region, data)
