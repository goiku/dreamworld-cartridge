index 0000000000000000000000000000000000000000..2a32e8fd255c087e4383033da391eab132f5e032
--- /dev/null
+++ b/api/pdw_movie.py
@@ -0,0 +1,86 @@
+"""Movie special home: its map, Rainbow Bridge, and Victini's treasure box."""
+import hashlib
+
+from werkzeug.exceptions import BadRequest
+
+from api.pdw_dreamland import _require_playing
+from api.routes import Query, endpoint
+from config import ASSET_LANG, LANG
+from game_sync_server.entralinked.model.pkmn.pkmn_info import is_movie_dragon
+from game_sync_server.entralinked.utility.db_manager import db
+from utils import pokemon, save_data
+from utils.messages import message
+
+# The original spxml contains a different campaign number for each regional release.
+MOVIE_HOME_ID = {"ja": 2, "ko": 3}.get(ASSET_LANG, 4)
+MOVIE_HOME_NAME = {"ja": "ポケモンえいが", "en": "Pokémon Movie", "fr": "Film Pokémon",
+                   "de": "Pokémon-Film", "es": "Película Pokémon", "it": "Film dei Pokémon",
+                   "ko": "포켓몬 영화", "zh": "宝可梦电影"}
+
+
+@endpoint("pdw.home.campaign_island_list")
+def special_homes(_query: Query) -> dict:
+    homes = []
+    if save_data.get_current_gscd():
+        homes.append({"campaign_island_id": MOVIE_HOME_ID, "campaign_island_name": MOVIE_HOME_NAME[LANG]})
+    return {"campaign_island_list": homes}
+
+
+def _dragon(gscd: str) -> int | None:
+    sleeper = pokemon.get_sleeper(gscd)
+    if not sleeper:
+        return None
+    eligible = sleeper.get("movie_dragon")
+    if eligible is None:
+        # Old uploads retained the Cherish Ball and original trainer, but not their trainer IDs.
+        eligible = is_movie_dragon(sleeper["pokemon_no"], sleeper["oyaname"], sleeper["ball_name"], sleeper["level"])
+    return sleeper["pokemon_no"] if eligible else None
+
+
+def _bridge_error(key: str) -> dict:
+    return {"error": {"code": 400, "details": {key: message("movie_dragon_required" if key == "celeb_not_found"
+                                                          else "unavailable_island")}}}
+
+
+@endpoint("pdw.home.campaign_island_bridge")
+def special_bridge(query: Query) -> dict:
+    gscd = save_data.get_current_gscd()
+    if not gscd or query.get("campaign_island_id") != str(MOVIE_HOME_ID):
+        return _bridge_error("not_found")
+    with db.transaction():
+        data = save_data.read_player_data(gscd)
+        member = data["member"]
+        _require_playing(member)
+        dragon = _dragon(gscd)
+        if dragon is None:
+            return _bridge_error("celeb_not_found")
+        def open_visit(current: dict) -> None:
+            progress = current.setdefault("movie_special_home", {})
+            progress["visit"] = {"tuck": member["sleep_pokemon_count"], "dragon": dragon,
+                                 "previous": int(dragon in progress.get("cleared", []))}
+        db.update(gscd, "player_data", open_visit)
+    return {}
+
+
+@endpoint("pdw.dreamland.campaign_island_game_clear", methods=("POST",))
+def finish_treasure_box(query: Query) -> dict:
+    gscd = save_data.get_current_gscd()
+    if not gscd or query.get("campaign_island_id") != str(MOVIE_HOME_ID):
+        raise BadRequest("Unknown special home.")
+    with db.transaction():
+        data = save_data.read_player_data(gscd)
+        member = data["member"]
+        _require_playing(member)
+        dragon = _dragon(gscd)
+        visit = data.get("movie_special_home", {}).get("visit", {})
+        if dragon is None or visit.get("tuck") != member["sleep_pokemon_count"] or visit.get("dragon") != dragon:
+            raise BadRequest("No active movie bridge visit.")
+        # With a null token the Flash client's untyped addition produces the numeric rank.
+        token = data.get("token") or ""
+        results = {hashlib.md5(f"{rank}{token}".encode()).hexdigest(): rank for rank in (0, 1)}
+        result = results.get(query.get("result", ""))
+        if result is None:
+            raise BadRequest("Invalid treasure box result.")
+        if result and dragon not in data["movie_special_home"].get("cleared", []):
+            db.update(gscd, "player_data", lambda current: current["movie_special_home"].setdefault("cleared", []).append(dragon))
+        return {"is_game": visit["previous"]}
