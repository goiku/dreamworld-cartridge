diff --git a/templates/island_friends.html b/templates/island_friends.html
new file mode 100644
index 0000000000000000000000000000000000000000..c49b9845e8da7305e3cbe73535de7d01efc7a46e
--- /dev/null
+++ b/templates/island_friends.html
@@ -0,0 +1,47 @@
+{% extends "island_base.html" %}
+{% block main %}
+<section class="hero">
+  <div><h1>{{ t.islands }}</h1>{% if card %}<p>{{ t.automatic }}</p>{% else %}<p>{{ t.login }}</p><a class="button" href="/login/pgl.html">{{ t.signin }}</a>{% endif %}</div>
+  <img src="{{ url_for('.picture',item_id=201) }}" alt="" width="180" height="180">
+</section>
+{% if card %}
+{% if notice in ('imported','kept','error','unreachable','paired') %}<p role="status" class="notice">{{ t[notice] }}</p>{% endif %}
+<p id="island-feedback" role="status" class="notice" data-error="{{ t.error }}" hidden></p>
+<section class="island-list" data-revision="{{ revision }}" aria-label="{{ t.friends }}">
+{% for f in friends %}
+  <article class="pal" data-island="{{ f.island_id }}">
+    <img class="mini" src="{{ url_for('.picture',item_id=f.house) }}" loading="lazy" alt="">
+    <div class="pal-body"><h2>{{ f.name }}</h2>
+    <p class="dates">{{ t.updated }} <time data-time="{{ f.updated_at }}">{{ date(f.updated_at) }}</time></p>
+    {% set status = delivery[f.island_id] %}
+    <p class="dates" data-last-sync {% if not status.last_sync %}hidden{% endif %}>{{ t.recent }}
+      <time{% if status.last_sync %} data-time="{{ status.last_sync }}"{% endif %}>{{ date(status.last_sync) if status.last_sync else '' }}</time></p>
+    <p class="dates" data-pending {% if not status.summary %}hidden{% endif %}>{{ status.summary }}</p>
+    <form method="post" action="{{ url_for('.enter',island_id=f.island_id) }}" class="actions">
+      <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="event_id" value="{{ f.event_id }}">
+      <button type="submit" class="primary">{{ t.visit }}</button>
+      <a href="{{ url_for('.profile',island_id=f.island_id) }}">{{ t.profile }}</a>
+    </form>
+    {% if f.paired %}<details><summary>{{ t.pair }}</summary>
+        <button type="button" data-forget="{{ f.island_id }}">{{ t.unpair }}</button></details>{% endif %}
+    </div>
+  </article>
+{% else %}<p class="empty">{{ t.empty }}</p>{% endfor %}
+</section>
+<section class="tools" id="sharing">
+  <h2>{{ t.pair }}</h2><p>{{ t.disclosure }}</p>
+  <div class="pair-actions"><button type="button" id="invite">{{ t.make }}</button>
+  <form id="join"><label for="pair-code">{{ t.code }}</label><div class="input-action"><input id="pair-code" type="text" required maxlength="240" autocapitalize="off" spellcheck="false" autocomplete="off"><button class="primary">{{ t.join }}</button></div></form></div>
+  <div id="invitations" hidden><p>{{ t.invitehelp }}</p><div id="codes"></div></div>
+  <div class="share"><a class="button" href="{{ url_for('.download') }}" download>{{ t.export }}</a>
+      <form method="post" enctype="multipart/form-data" action="{{ url_for('.upload') }}" id="upload">
+        <input type="hidden" name="csrf" value="{{ csrf }}">
+        <label class="file-button button">{{ t.import }}<input type="file" name="snapshot" required accept=".json,application/json" aria-label="{{ t.import }}"></label>
+        <noscript><button>{{ t.import }}</button></noscript>
+      </form></div>
+</section>
+<section class="tools" id="footprints"><h2>{{ t.feet }}</h2>
+{% if feet %}<ul class="foot-log">{% for foot in feet %}<li><strong>{{ foot.name }}</strong> <time data-time="{{ foot.visited_at }}">{{ date(foot.visited_at) }}</time></li>{% endfor %}</ul>{% else %}<p>{{ t.nofeet }}</p>{% endif %}</section>
+{% if original %}<section class="tools"><h2>{{ t.original }}</h2><ul>{% for f in original %}<li>{{ f.pgl_name }}</li>{% endfor %}</ul><a href="/pdw/">{{ t.home }}</a></section>{% endif %}
+{% endif %}
+{% endblock %}
diff --git a/templates/island_profile.html b/templates/island_profile.html
new file mode 100644
index 0000000000000000000000000000000000000000..7365b01e5276d6a0edbc5214a8abeb9aa67c7506
--- /dev/null
+++ b/templates/island_profile.html
@@ -0,0 +1,29 @@
+{% extends "island_base.html" %}
+{% block title %}{{ owner }} · {{ t.profile }}{% endblock %}
+{% block main %}
+<div class="room-head"><div><h1>{{ owner }} <span class="room-type">· {{ t.profile }}</span></h1>
+<p class="dates">{{ t.updated }} <time data-time="{{ doc.updated_at }}">{{ date(doc.updated_at) }}</time></p></div>
+{% if not in_room %}<a class="button primary" href="{{ url_for('.room',island_id=doc.island_id) }}">{{ t.visit }}</a>{% endif %}</div>
+{% if interactive or history %}
+<section id="interactions"><h2>{{ ui.title }}</h2><p>{{ ui.hint }}</p>
+{% if request.args.notice in ('saved','changed') %}<p role="status">{{ ui[request.args.notice] }}</p>{% endif %}
+{% macro fields(kind,index) -%}
+<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ doc.version }}">
+<input type="hidden" name="kind" value="{{ kind }}"><input type="hidden" name="slot" value="{{ index }}">
+{% if in_room %}<input type="hidden" name="in_room" value="1">{% endif %}
+{%- endmacro %}
+{% if interactive %}
+{% for plot in doc.content.garden %}{% if plot.planted_at and plot.dirt_hp < full and plot.kinomi_state < ripe %}
+<form action="{{ url_for('.interact',island_id=doc.island_id) }}" method="post">{{ fields('water',loop.index0) }}
+<button>{{ ui.water }} · {{ item_name(plot.pokeitem_id) }} ({{ plot.x }}, {{ plot.y }})</button></form>{% endif %}{% endfor %}
+{% for slot in doc.content.shelf %}{% set options = stock | rejectattr('0','equalto',slot.item_id) | list %}{% if slot.item_id and options %}
+<form action="{{ url_for('.interact',island_id=doc.island_id) }}" method="post">{{ fields('trade',loop.index0) }}
+<label>{{ ui.offer }} <select name="payment">{% for id,qty in options %}<option value="{{ id }}">{{ item_name(id) }} ×{{ qty }}</option>{% endfor %}</select></label>
+<button>{{ ui.trade }} · {{ item_name(slot.item_id) }}</button></form>{% endif %}{% endfor %}
+{% endif %}
+{% if history %}<ul>{% for action in history %}<li>{{ ui[action.kind] }} · {{ item_name(action.expected) if action.kind=='trade' else '#' ~ (action.slot+1) }} · {{ ui[action.status] }}</li>{% endfor %}</ul>{% endif %}
+</section>{% endif %}
+<div class="records">{% for title,rows in groups %}<section><h2>{{ title }}</h2>
+{% if rows %}<dl>{% for key,value in rows %}<div><dt>{{ key }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl>
+{% else %}<p>{{ t.none }}</p>{% endif %}</section>{% endfor %}</div>
+{% endblock %}
