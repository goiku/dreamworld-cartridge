@@ -0,0 +1,474 @@
+"""Cartridge-scoped promotions and native Generation V Wonder Card deliveries."""
+import binascii
+import hashlib
+import json
+import struct
+import time
+from collections import Counter
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import dataclass
+from functools import cache
+from http.client import HTTPException
+from urllib.parse import quote
+from urllib.request import urlopen
+
+from game_sync_server.entralinked.model.player.dream_data import DreamEncounter, DreamItem
+from game_sync_server.entralinked.model.save_file import _crypt_array
+from game_sync_server.entralinked.utility.db_manager import db
+from game_sync_server.entralinked.utility.gsid_utility import gsid_to_gscd
+from utils import japanese_card_archive
+from utils.data import load_json_data
+
+ARCHIVE = "https://raw.githubusercontent.com/projectpokemon/EventsGallery/f1f3095183ee54dca63216164adb1f278714ec55/Released/Gen%205/Wondercards/"
+LANGUAGES = {1: ("JPN", "J"), 2: ("ENG", "E"), 3: ("FRE", "F"), 4: ("ITA", "I"),
+             5: ("GER", "G"), 7: ("SPA", "S"), 8: ("KOR", "K")}
+VERSIONS = {20: 16, 21: 32, 22: 64, 23: 128}
+ROM_CODES = {"IRA": 20, "IRB": 21, "IRD": 22, "IRE": 23}
+
+# The original B/W Eeveelution promotion offered one of seven partners.
+EEVEES = (134, 135, 136, 196, 197, 470, 471)
+
+
+@dataclass(frozen=True)
+class Gift:
+    key: str
+    group: str
+    name: str
+    mask: int
+    language: str = ""
+    filename: str = ""
+    digest: str = ""
+    number: int = 0
+    species: int = 0
+    move: int = 0
+    gender: int = 0
+    regions: tuple = ()
+    full_digest: str = ""
+    signature: str = ""
+    subject: int = 0
+    card_type: int = 0
+    independent: bool = False
+    event: str = ""
+    items: tuple = ()
+    card_title: str = ""
+    japanese_title: str = ""
+
+
+@cache
+def catalog():
+    gifts = {}
+    for mask, species, move, gender, regions, *details in load_json_data("dream_promotions"):
+        info = details[0] if details else {}
+        key = f"d-{mask}-{species}-{move}"
+        group = "eevee" if species in EEVEES else f"d-{species}-{move}"
+        gifts[key] = Gift(key, group, "", mask, species=species, move=move, gender=gender,
+                          regions=tuple(regions), event=info.get("event", ""),
+                          items=(info["item"],) if "item" in info else ())
+    for slug, japanese, name, items in load_json_data("japan_berry_promotions"):
+        key = f"b-{slug}"
+        gifts[key] = Gift(key, key, name, 192, regions=("JPN",), event="berries",
+                          items=tuple(items), japanese_title=japanese)
+    for language, filename, digest, mask, full, signature, number, *info in load_json_data("gift_cards"):
+        key = f"w-{language}-{digest}"
+        subject, card_type, single, card_title = info or (0, 0, 1, "")
+        independent = single == 0
+        group = key if independent else f"card-{number}"
+        gifts[key] = Gift(key, group, filename.split(" - ", 1)[1][:-4], mask, language,
+                          filename, digest, number, full_digest=full, signature=signature,
+                          subject=subject, card_type=card_type, independent=independent, card_title=card_title)
+    return gifts
+
+
+def compatible(gift, rom, lang):
+    return bool(gift.mask & VERSIONS.get(rom, 0) and lang in LANGUAGES
+                and (not gift.language or gift.language == LANGUAGES[lang][0])
+                and (not gift.regions or LANGUAGES[lang][0] in gift.regions))
+
+
+@cache
+def variant_counts(rom, lang):
+    return Counter(gift.group for gift in catalog().values() if compatible(gift, rom, lang))
+
+
+@cache
+def variant_signatures(rom, lang):
+    result = {}
+    for gift in catalog().values():
+        if gift.signature and compatible(gift, rom, lang):
+            result.setdefault(gift.signature, []).append(gift)
+    return result
+
+
+def schema(conn):
+    conn.execute("""CREATE TABLE IF NOT EXISTS distribution_visit_album (
+        card TEXT PRIMARY KEY, rom INTEGER NOT NULL, lang INTEGER NOT NULL, album TEXT)""")
+    conn.execute("""CREATE TABLE IF NOT EXISTS distribution_cartridges (
+        card TEXT PRIMARY KEY, wfc TEXT NOT NULL, rom INTEGER NOT NULL, lang INTEGER NOT NULL,
+        album TEXT)""")
+    conn.execute("""CREATE TABLE IF NOT EXISTS distribution_orders (
+        card TEXT NOT NULL, family TEXT NOT NULL, gift TEXT NOT NULL, status TEXT NOT NULL,
+        payload BLOB, PRIMARY KEY(card,family))""")
+    conn.execute("""CREATE TABLE IF NOT EXISTS distribution_lists (
+        token BLOB PRIMARY KEY, card TEXT NOT NULL, gift TEXT NOT NULL, expires INTEGER NOT NULL)""")
+    conn.execute("""CREATE TABLE IF NOT EXISTS distribution_next (
+        card TEXT PRIMARY KEY, gift TEXT NOT NULL)""")
+    conn.execute("""CREATE TABLE IF NOT EXISTS distribution_dream_options (
+        card TEXT NOT NULL, gift TEXT NOT NULL, gender INTEGER NOT NULL, PRIMARY KEY(card,gift))""")
+    conn.execute("""CREATE TABLE IF NOT EXISTS distribution_variants (
+        card TEXT NOT NULL, gift TEXT NOT NULL, status TEXT NOT NULL, PRIMARY KEY(card,gift))""")
+
+
+def _card_signature(pgf):
+    # The receiver stamps the date and toggles the collected bit after delivery.
+    return hashlib.sha256(pgf[:0xac] + pgf[0xb0:0xb4] + bytes([pgf[0xb4] & ~2]) + pgf[0xb5:204]).hexdigest()
+
+
+def cartridge_album(raw, signatures=None):
+    start, size = 0x1C800, 0xA94
+    block = raw[start:start + size]
+    if (len(raw) < start + size + 4 or not any(block)
+            or binascii.crc_hqx(block, 0xffff) != int.from_bytes(raw[start + size + 2:start + size + 4], "little")):
+        return None
+    data = bytearray(block[:-4])
+    _crypt_array(data, int.from_bytes(block[-4:], "little"))
+    records = {str(i): "received" for i in range(2048) if data[i//8] & (1 << (i%8))}
+    for offset in range(0x100, len(data), 204):
+        number = struct.unpack_from("<H", data, offset + 0xb0)[0]
+        kind = data[offset + 0xb3]
+        if kind in (1, 2, 3) and 0 < number < 2048:
+            records[str(number)] = "collected" if data[offset + 0xb4] & 2 else "at_center"
+            if signatures is not None:
+                signature = _card_signature(bytes(data[offset:offset+204]))
+                signatures[signature] = records[str(number)]
+    return records
+
+
+def _upgrade_variant_orders(conn, card):
+    # Older releases grouped every order by card number. Preserve its payload and delivery phase.
+    for row in conn.execute("SELECT gift,family FROM distribution_orders WHERE card=? AND family LIKE 'card-%'", (card,)).fetchall():
+        gift = catalog().get(row["gift"])
+        if gift and gift.independent:
+            conn.execute("UPDATE distribution_orders SET family=? WHERE card=? AND family=?",
+                         (gift.group, card, row["family"]))
+
+
+def merge_album(conn, card, evidence, signatures=None):
+    if evidence is None:
+        return
+    _upgrade_variant_orders(conn, card)
+    old = conn.execute("SELECT album,rom,lang FROM distribution_cartridges WHERE card=?", (card,)).fetchone()
+    history = json.loads(old["album"]) if old and old["album"] else {}
+    for number, state in evidence.items():
+        # A previously seen, now discarded card still counts as received.
+        if history.get(number) != "collected":
+            history[number] = state
+    for number in history.keys() - evidence.keys():
+        if history[number] == "at_center":
+            history[number] = "received"
+    conn.execute("UPDATE distribution_cartridges SET album=? WHERE card=?", (json.dumps(history), card))
+    if old and signatures is not None:
+        known = variant_signatures(old["rom"], old["lang"])
+        conn.execute("UPDATE distribution_variants SET status='received' WHERE card=? AND status='at_center'", (card,))
+        for signature, phase in signatures.items():
+            matches = known.get(signature, ())
+            if len(matches) == 1:
+                conn.execute("""INSERT INTO distribution_variants VALUES(?,?,?) ON CONFLICT(card,gift) DO UPDATE
+                             SET status=excluded.status WHERE distribution_variants.status<>'collected'""",
+                             (card, matches[0].key, phase))
+                if matches[0].independent:
+                    conn.execute("UPDATE distribution_orders SET status='delivered',payload=NULL WHERE card=? AND gift=?",
+                                 (card, matches[0].key))
+    conn.executemany("""UPDATE distribution_orders SET status='delivered',payload=NULL
+                         WHERE card=? AND family=?""", ((card, "card-" + n) for n in history))
+
+
+def observe_upload(conn, card, wfc, trainer, raw):
+    if (not trainer.game_sync_id or gsid_to_gscd(trainer.game_sync_id) != card
+            or trainer.game not in VERSIONS or trainer.language not in LANGUAGES):
+        return
+    schema(conn)
+    conn.execute("""INSERT INTO distribution_cartridges(card,wfc,rom,lang) VALUES(?,?,?,?)
+                 ON CONFLICT(card) DO UPDATE SET wfc=excluded.wfc,rom=excluded.rom,lang=excluded.lang""",
+                 (card, wfc, trainer.game, trainer.language))
+    signatures = {}
+    merge_album(conn, card, cartridge_album(raw, signatures), signatures)
+
+
+def state(conn, card):
+    schema(conn)
+    _upgrade_variant_orders(conn, card)
+    identity = conn.execute("SELECT * FROM distribution_cartridges WHERE card=?", (card,)).fetchone()
+    if identity is None:
+        identity = conn.execute("SELECT rom,lang,album,NULL AS wfc FROM distribution_visit_album WHERE card=?",
+                                (card,)).fetchone()
+    orders = {row["family"]: row for row in conn.execute(
+        "SELECT family,gift,status FROM distribution_orders WHERE card=?", (card,))}
+    album = json.loads(identity["album"]) if identity and identity["album"] is not None else None
+    if album is not None:
+        album.update(conn.execute("SELECT gift,status FROM distribution_variants WHERE card=?", (card,)))
+    return identity, orders, album
+
+
+def status(gift, orders, album):
+    order = orders.get(gift.group)
+    if gift.number and album is not None:
+        if receipt := album.get(gift.key):
+            return receipt
+        if not gift.independent and (receipt := album.get(str(gift.number))):
+            return receipt
+    if order:
+        return order["status"] if order["gift"] == gift.key else "alternative"
+    if gift.number and (album is None or gift.independent and str(gift.number) in album):
+        return "unknown"
+    return "available"
+
+
+def card_binary(gift, lang):
+    if gift.full_digest:
+        filename = quote(gift.filename[:-4] + ".wc5full", safe="")
+        url = ARCHIVE.replace("/Wondercards/", "/Wondercard%20Fulls/") + filename
+        with urlopen(url, timeout=8) as response:
+            full = response.read(721)
+        if (len(full) != 720 or hashlib.sha1(b"blob 720\0" + full).hexdigest() != gift.full_digest
+                or int.from_bytes(full[0xb0:0xb2], "little") != gift.number):
+            raise ValueError("Invalid archived distribution")
+        if (full[-5] == lang and full[0xce] == gift.mask and not full[0xb4] & 2
+                and binascii.crc_hqx(full[:-2], 0xffff) == int.from_bytes(full[-2:], "little")):
+            return full
+    raw = japanese_card_archive.lookup(gift.digest) if gift.language == "JPN" else None
+    if raw is None:
+        url = ARCHIVE + gift.language + "/" + quote(gift.filename, safe="")
+        with urlopen(url, timeout=8) as response:
+            raw = response.read(205)
+    if (len(raw) != 204 or hashlib.sha1(b"blob 204\0" + raw).hexdigest() != gift.digest
+            or int.from_bytes(raw[0xb0:0xb2], "little") != gift.number or raw[0xb3] not in (1, 2, 3)):
+        raise ValueError("Invalid archived gift")
+    return pack_card(raw, gift, lang)
+
+
+def pack_card(raw, gift, lang):
+    data = bytearray(720)
+    data[:204] = raw
+    data[0xac:0xb0] = bytes(4)
+    data[0xb4] &= ~2
+    data[0xce] = gift.mask
+    data[0xd0:-6] = b"\xff" * (len(data) - 6 - 0xd0)
+    data[0xd0:0xd0+72] = raw[0x60:0x60+72]
+    data[0xd0+72:0xd0+74] = b"\xff\xff"
+    data[-5] = lang
+    struct.pack_into("<H", data, 718, binascii.crc_hqx(data[:-2], 0xffff))
+    return bytes(data)
+
+
+def delivery_target_error(conn, identity, rom, lang):
+    if not identity or (identity["rom"], identity["lang"]) != (rom, lang):
+        return "sync"
+    if identity["wfc"] is not None and conn.execute(
+        "SELECT count(*) FROM distribution_cartridges WHERE wfc=? AND rom=? AND lang=?",
+        (identity["wfc"], rom, lang),
+    ).fetchone()[0] != 1:
+        return "ambiguous"
+    return None
+
+
+def unclaimed_cards(rom, lang, orders, album):
+    if album is None:
+        return {}
+    counts = variant_counts(rom, lang)
+    return {
+        gift.group: gift for gift in catalog().values()
+        if gift.number and compatible(gift, rom, lang) and counts[gift.group] == 1
+        and status(gift, orders, album) == "available"
+    }
+
+
+def queue_unclaimed_cards(card, rom, lang):
+    """Append verified cards behind the existing queue. A retry only fills remaining gaps."""
+    with db.transaction() as conn:
+        identity, orders, album = state(conn, card)
+        if error := delivery_target_error(conn, identity, rom, lang):
+            return error, 0, 0
+        if album is None:
+            return "unknown_help", 0, 0
+        candidates = unclaimed_cards(rom, lang, orders, album)
+    if not candidates:
+        return "bulk_result", 0, 0
+
+    # Prepare bytes without holding the save lock, including on first-time installations.
+    if lang == 1:
+        try:
+            japanese_card_archive.ensure_installed()
+        except (OSError, ValueError, HTTPException):
+            return "bulk_result", 0, len(candidates)
+
+    def prepare(gift):
+        try:
+            return card_binary(gift, lang)
+        except (OSError, ValueError, HTTPException):
+            return None
+
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        payloads = dict(zip(candidates, pool.map(prepare, candidates.values())))
+
+    with db.transaction() as conn:
+        identity, orders, album = state(conn, card)
+        if error := delivery_target_error(conn, identity, rom, lang):
+            return error, 0, 0
+        if album is None:
+            return "unknown_help", 0, 0
+        added = failed = 0
+        for family, gift in candidates.items():
+            if status(gift, orders, album) != "available":
+                continue
+            if payloads[family] is None:
+                failed += 1
+                continue
+            conn.execute("INSERT INTO distribution_orders VALUES(?,?,?,'queued',?)",
+                         (card, family, gift.key, payloads[family]))
+            added += 1
+    return "bulk_result", added, failed
+
+
+def queue(card, gift, rom, lang, gender=None, *, chest=False):
+    if gender is not None and (gift.event != "cafe" or gender not in (0, 1)):
+        return "incompatible"
+    if chest and gift.event != "berries":
+        return "incompatible"
+    def allowed(conn):
+        identity, orders, album = state(conn, card)
+        if not compatible(gift, rom, lang):
+            return "incompatible"
+        if gift.number:
+            if error := delivery_target_error(conn, identity, rom, lang):
+                return error
+        current = status(gift, orders, album)
+        if current != "available" and not (gift.number and current == "unknown"):
+            return current
+        if chest and db.read(card, "chest_data") is None:
+            return "sync"
+        return None
+    with db.transaction() as conn:
+        if reason := allowed(conn):
+            return reason
+    # Do not hold a database write lock during a possible network fetch.
+    payload = card_binary(gift, lang) if gift.number else None
+    with db.transaction() as conn:
+        if reason := allowed(conn):
+            return reason
+        phase = "in_chest" if chest else "queued"
+        conn.execute("INSERT INTO distribution_orders VALUES(?,?,?,?,?)",
+                     (card, gift.group, gift.key, phase, payload))
+        if chest:
+            from utils import managers
+            managers.get_chest(card).move_items(dict(Counter(gift.items)))
+        if gift.event == "cafe" and gender is not None:
+            conn.execute("INSERT INTO distribution_dream_options VALUES(?,?,?)", (card, gift.key, gender))
+        if gift.number:
+            conn.execute("INSERT OR REPLACE INTO distribution_next VALUES(?,?)", (card, gift.key))
+    return phase
+
+
+def prioritize(card, gift):
+    with db.transaction() as conn:
+        schema(conn)
+        row = conn.execute("""SELECT 1 FROM distribution_orders WHERE card=? AND gift=?
+                           AND status IN ('queued','sent') AND payload IS NOT NULL""", (card, gift.key)).fetchone()
+        if row:
+            conn.execute("UPDATE distribution_orders SET status='queued' WHERE card=? AND gift=?", (card, gift.key))
+            conn.execute("INSERT OR REPLACE INTO distribution_next VALUES(?,?)", (card, gift.key))
+    return "queued" if row else "incompatible"
+
+
+def wake_orders(conn, card):
+    return conn.execute("""SELECT o.gift,d.gender FROM distribution_orders o
+                              LEFT JOIN distribution_dream_options d USING (card,gift)
+                              WHERE o.card=? AND o.status='queued' AND o.payload IS NULL ORDER BY o.rowid""", (card,))
+
+
+def add_to_wake(conn, player, capacity, item_capacity):
+    schema(conn)
+    selected = []
+    for row in wake_orders(conn, player.gscd):
+        gift = catalog().get(row["gift"])
+        if not gift or gift.number or not compatible(gift, player.rom_id, player.langcode):
+            continue
+        if gift.species and len(player.encounters) >= capacity:
+            continue
+        if gift.items:
+            stacks = {item.pokeitem_id: item for item in player.items}
+            quantities = Counter(gift.items)
+            if (len(player.items) + len(quantities.keys() - stacks.keys()) > item_capacity
+                    or any(stacks[i].item_cnt + n > 255 for i, n in quantities.items() if i in stacks)):
+                continue
+            for item, count in quantities.items():
+                if item in stacks:
+                    stacks[item].item_cnt += count
+                else:
+                    player.items.append(DreamItem(item, count))
+        if gift.species:
+            gender = row["gender"] if row["gender"] is not None else gift.gender
+            player.encounters.append(DreamEncounter(gift.species, gift.move, 0, gender, 0))
+        selected.append(gift.key)
+    return selected
+
+
+def confirm_wake(conn, card, selected):
+    schema(conn)
+    conn.executemany("UPDATE distribution_orders SET status='delivered' WHERE card=? AND gift=? AND status='queued'",
+                     ((card, gift) for gift in selected))
+
+
+def wonder_queue(conn, card, token=None):
+    """A new DS session sees queued cards. The current token can also retry its sent card."""
+    return conn.execute("""SELECT o.gift FROM distribution_orders o LEFT JOIN distribution_next n
+                          ON n.card=o.card AND n.gift=o.gift WHERE o.card=?
+                          AND (o.status='queued' OR (o.status='sent' AND EXISTS
+                              (SELECT 1 FROM distribution_lists l WHERE l.card=o.card AND l.gift=o.gift
+                               AND l.token=? AND l.expires>=?)))
+                          AND o.payload IS NOT NULL ORDER BY (n.gift IS NOT NULL) DESC,o.rowid""",
+                        (card, token, int(time.time())))
+
+
+def download(wfc, form):
+    """The game requests a single gift at a time. An interrupted contents request is replayable."""
+    game = form.get("rhgamecd", "")
+    rom = ROM_CODES.get(game[:3])
+    language = form.get("attr1", "").removeprefix("MYSTERY_") or game[3:4]
+    lang = next((k for k, (_, suffix) in LANGUAGES.items() if suffix == language), None)
+    action = form.get("action")
+    file = form.get("contents", "")
+    token = hashlib.sha256(form["token"].encode("latin-1")).digest()
+    with db.transaction() as conn:
+        schema(conn)
+        if action == "contents":
+            selected = conn.execute("""SELECT o.card,o.gift,o.payload,c.rom,c.lang FROM distribution_lists l
+                JOIN distribution_orders o ON o.card=l.card AND o.gift=l.gift
+                JOIN distribution_cartridges c ON c.card=o.card
+                WHERE l.token=? AND l.expires>=? AND c.wfc=? AND o.status IN ('queued','sent')
+                AND NOT EXISTS (SELECT 1 FROM distribution_cartridges b WHERE b.wfc=c.wfc AND b.rom=c.rom
+                                AND b.lang=c.lang AND b.card<>c.card)""",
+                (token, int(time.time()), wfc)).fetchone()
+            if (selected and (not game or rom == selected["rom"]) and
+                    (not form.get("attr1") or lang == selected["lang"]) and
+                    file == "DW" + catalog()[selected["gift"]].digest[:12] + ".bin"):
+                conn.execute("UPDATE distribution_orders SET status='sent' WHERE card=? AND gift=?",
+                             (selected["card"], selected["gift"]))
+                return selected["payload"], 200
+            return b"", 404
+        identities = conn.execute("SELECT card FROM distribution_cartridges WHERE wfc=? AND rom=? AND lang=?",
+                                  (wfc, rom, lang)).fetchall()
+        row = None
+        if len(identities) == 1:
+            row = wonder_queue(conn, identities[0]["card"], token).fetchone()
+        if action == "count":
+            return str(int(row is not None)), 200
+        if action == "list":
+            if not row or form.get("offset", "0") not in ("", "0") or form.get("num") == "0":
+                return "\r\n", 200
+            gift = catalog()[row["gift"]]
+            now = int(time.time())
+            conn.execute("DELETE FROM distribution_lists WHERE expires<?", (now,))
+            conn.execute("INSERT OR REPLACE INTO distribution_lists VALUES(?,?,?,?)",
+                         (token, identities[0]["card"], gift.key, now + 3600))
+            return f"DW{gift.digest[:12]}.bin\t\tMYSTERY_{language}\t{gift.mask << 16:x}\t\t720\r\n", 200
+    return b"", 400
diff --git a/utils/gen4_gifts.py b/utils/gen4_gifts.py
new file mode 100644
index 0000000000000000000000000000000000000000..8250f5abc69b183c2b21681675ebbdf8200445a6
--- /dev/null
+++ b/utils/gen4_gifts.py
@@ -0,0 +1,96 @@
+"""Fourth-generation Nintendo WFC distributions, scoped to the WFC user and game."""
+import hashlib
+import time
+from functools import cache
+from http.client import HTTPException
+from urllib.request import urlopen
+
+from game_sync_server.entralinked.utility.db_manager import db
+from utils.data import load_json_data
+
+ARCHIVE = "https://raw.githubusercontent.com/ubergeek77/dwc_network_server_emulator/68fcdb2989e57a10ec8cf8398ff7506c4c73d390/dlc/"
+SIZE = 936
+
+
+@cache
+def catalog():
+    return load_json_data("gen4_wireless_gifts")
+
+
+def game_code(form):
+    for field in ("rhgamecd", "gamecd"):
+        code = form.get(field)
+        if code in catalog()["games"]:
+            return code
+    return None
+
+
+def _schema(conn):
+    conn.execute("""CREATE TABLE IF NOT EXISTS gen4_gift_list (
+        ticket BLOB PRIMARY KEY, owner TEXT, game TEXT, gift TEXT, until INTEGER, sent INTEGER DEFAULT 0)""")
+    conn.execute("""CREATE TABLE IF NOT EXISTS gen4_gift_download (
+        owner TEXT, game TEXT, gift TEXT, last_sent INTEGER, PRIMARY KEY(owner,game,gift))""")
+    conn.execute("CREATE TABLE IF NOT EXISTS gen4_gift_cache (gift TEXT PRIMARY KEY, content BLOB)")
+
+
+def _payload(gift):
+    with db.transaction() as conn:
+        cached = conn.execute("SELECT content FROM gen4_gift_cache WHERE gift=?", (gift,)).fetchone()
+    if cached:
+        return cached[0]
+    game, name = catalog()["files"][gift]
+    with urlopen(f"{ARCHIVE}{game}/{name}", timeout=5) as response:
+        raw = response.read(SIZE + 1)
+    if len(raw) != SIZE or hashlib.sha1(b"blob 936\0" + raw).hexdigest() != gift:
+        raise ValueError("The archived distribution does not match its catalog entry")
+    with db.transaction() as conn:
+        conn.execute("INSERT OR IGNORE INTO gen4_gift_cache VALUES(?,?)", (gift, raw))
+    return raw
+
+
+def download(owner, form, game):
+    action = form.get("action")
+    ticket = hashlib.sha256(form["token"].encode("latin-1")).digest()
+    now = int(time.time())
+    with db.transaction() as conn:
+        _schema(conn)
+        conn.execute("DELETE FROM gen4_gift_list WHERE until<?", (now,))
+        selected = conn.execute(
+            "SELECT game,gift FROM gen4_gift_list WHERE ticket=? AND owner=?", (ticket, owner)
+        ).fetchone()
+        if selected and game and selected["game"] != game:
+            return b"", 400
+        if action == "contents":
+            if not selected:
+                return b"", 404
+            game, gift = selected
+            if form.get("contents") != catalog()["files"][gift][1]:
+                return b"", 404
+        elif action in ("list", "count") and game:
+            if action == "count":
+                return "1", 200
+            if form.get("offset", "0") not in ("", "0") or form.get("num") == "0":
+                return "\r\n", 200
+            if selected:
+                gift = selected["gift"]
+            else:
+                sent = dict(conn.execute(
+                    "SELECT gift,last_sent FROM gen4_gift_download WHERE owner=? AND game=?", (owner, game)
+                ))
+                gift = min(catalog()["games"][game], key=lambda key: sent.get(key, 0))
+                conn.execute("INSERT INTO gen4_gift_list(ticket,owner,game,gift,until) VALUES(?,?,?,?,?)",
+                             (ticket, owner, game, gift, now+3600))
+            name = catalog()["files"][gift][1]
+            return f"{name}\t\t\t\t\t{SIZE}\r\n", 200
+        else:
+            return b"", 400
+    try:
+        raw = _payload(gift)
+    except (OSError, HTTPException, ValueError):
+        return b"", 503
+    with db.transaction() as conn:
+        first = conn.execute("UPDATE gen4_gift_list SET sent=1 WHERE ticket=? AND sent=0", (ticket,))
+        if first.rowcount:
+            conn.execute("""INSERT INTO gen4_gift_download VALUES(?,?,?,?) ON CONFLICT(owner,game,gift)
+                            DO UPDATE SET last_sent=excluded.last_sent""", (owner, game, gift, time.time_ns()))
+    return raw, 200
