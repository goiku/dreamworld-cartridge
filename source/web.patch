+def _change(query: Query, *, remove: bool) -> dict:
+    gscd = current_save()
+    if not gscd:
+        raise Forbidden()
+    value = query.get("video_code", "").strip()
+    if not VIDEO_NUMBER.fullmatch(value):
+        return {"error": {"details": {"video_code": message("bad_video_number")}}}
+    digits = value.replace("-", "")
+    number = f"{digits[:2]}-{digits[2:7]}-{digits[7:]}"
+
+    def edit(data: dict) -> None:
+        codes = data.setdefault("favorite_video_codes", [])
+        if remove:
+            if number in codes:
+                codes.remove(number)
+        elif number not in codes:
+            codes.insert(0, number)
+            del codes[MAX_FAVORITES:]
+
+    saved = db.update(gscd, "player_data", edit)
+    return _list(saved["favorite_video_codes"])
+
+
+@endpoint("pgl.member.profile.video_regist", methods=("POST",))
+def register(query: Query) -> dict:
+    return _change(query, remove=False)
+
+
+@endpoint("pgl.member.profile.video_delete", methods=("POST",))
+def delete(query: Query) -> dict:
+    return _change(query, remove=True)
